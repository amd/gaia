#
# embed_skills.cmake — run with `cmake -P`.
# Compiles every <dir>/<skill>/SKILL.md under SKILL_DIRS (a ;-list, highest
# precedence first) into OUTPUT as a gaia::EmbeddedSkill table, so the binary
# carries its skill library and stays a single file.

if(NOT DEFINED OUTPUT)
    message(FATAL_ERROR "embed_skills.cmake: OUTPUT is required")
endif()

set(_decls "")
set(_entries "")
set(_count 0)
foreach(_dir IN LISTS SKILL_DIRS)
    if(NOT IS_DIRECTORY "${_dir}")
        continue()
    endif()
    file(GLOB _children LIST_DIRECTORIES true "${_dir}/*")
    list(SORT _children)
    foreach(_child IN LISTS _children)
        if(NOT EXISTS "${_child}/SKILL.md")
            continue()
        endif()
        get_filename_component(_name "${_child}" NAME)
        file(READ "${_child}/SKILL.md" _hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
        string(APPEND _decls "const unsigned char kSkill${_count}[] = {${_bytes}0x00};\n")
        string(APPEND _entries "    {\"${_name}\", reinterpret_cast<const char*>(kSkill${_count})},\n")
        math(EXPR _count "${_count} + 1")
    endforeach()
endforeach()

if(_count EQUAL 0)
    set(_entries "    {nullptr, nullptr},\n")
endif()

set(_content "// Generated by cmake/embed_skills.cmake. Do not edit.
#include <cstddef>

#include <gaia/skill_manager.h>

namespace {
${_decls}}  // namespace

extern const gaia::EmbeddedSkill kGaiaEmbeddedSkills[] = {
${_entries}};
extern const std::size_t kGaiaEmbeddedSkillCount = ${_count};
")

# Rewrite only on change, so an unchanged skill library does not relink.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
    if(_old STREQUAL _content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${_content}")
