# Copy outside the repository and chmod 600. Never commit credentials.
GAIA_GAIA_SIDECAR_TOKEN=replace-with-a-random-secret
GAIA_SERVICE_MODEL=replace-with-the-exact-model-id
GAIA_SERVICE_PORT=8080

# External Lemonade (for a host endpoint on Docker Desktop):
# LEMONADE_BASE_URL=http://host.docker.internal:13305/api/v1
# LEMONADE_API_KEY=replace-if-required

# Or use the bundled Lemonade daemon and configure its Fireworks provider:
# GAIA_SERVICE_CLOUD_PROVIDER=fireworks
# GAIA_SERVICE_CLOUD_URL=https://api.fireworks.ai/inference/v1
# LEMONADE_FIREWORKS_API_KEY=replace-with-provider-key
# Set GAIA_SERVICE_MODEL to the advertised fireworks.<upstream-model-id>.

# Worker admission and run limits (positive integers):
GAIA_SERVICE_MAX_REQUEST_BYTES=1048576
GAIA_SERVICE_MAX_CONCURRENT_RUNS=1
GAIA_SERVICE_MAX_STEPS=20
GAIA_SERVICE_RUN_TIMEOUT_SECONDS=300
