#!/bin/sh
# GAIA Agent UI — Debian post-install script.
#
# Registers the application with the desktop environment. Auto-start at
# login is OFF by default (Debian convention, per plan §4.1); users enable
# it via the in-app settings which writes ~/.config/autostart/gaia-agent-ui.desktop.
#
# See docs/plans/desktop-installer.mdx §7 Phase E.

set -e

case "$1" in
    configure)
        # Chromium's SUID sandbox helper must be owned by root and have mode
        # 4755. electron-builder packages it as 755; we fix it here so the
        # app can start without --no-sandbox.
        if [ -f /opt/GAIA/chrome-sandbox ]; then
            chown root:root /opt/GAIA/chrome-sandbox
            chmod 4755 /opt/GAIA/chrome-sandbox
        fi
        # Our custom after-install replaces electron-builder's, which created this link.
        # Like postrm, leave a file or link that is not ours in place.
        if { [ ! -e /usr/bin/gaia-desktop ] && [ ! -L /usr/bin/gaia-desktop ]; } ||
           [ "$(readlink /usr/bin/gaia-desktop 2>/dev/null)" = "/opt/GAIA/gaia-desktop" ]; then
            ln -sf /opt/GAIA/gaia-desktop /usr/bin/gaia-desktop
        fi
        # A Ryzen AI NPU runs FastFlowLM, which pins its model in locked
        # memory; a desktop session's default 8 MB stops it (amd/gaia#6632).
        # Lift it for user sessions, as FastFlowLM's own Linux guide does.
        # The same files as gaia.llm.npu_linux.MEMLOCK_DROPINS; they apply
        # after a restart. Only on a first install ($2 is the version being
        # upgraded from), so an administrator who deleted them keeps that, and
        # only where the NPU driver is loaded. They apply to every user.
        if [ -z "$2" ] && [ -d /sys/module/amdxdna ]; then
            marker='# GAIA: FastFlowLM pins NPU models in locked memory (https://amd-gaia.ai/docs/guides/npu#linux).'
            mkdir -p /etc/security/limits.d /etc/systemd/system/user@.service.d
            printf '%s\n* soft memlock unlimited\n* hard memlock unlimited\n' "$marker" \
                > /etc/security/limits.d/90-gaia-npu.conf
            printf '%s\n[Service]\nLimitMEMLOCK=infinity\n' "$marker" \
                > /etc/systemd/system/user@.service.d/90-gaia-npu-memlock.conf
            systemctl daemon-reload 2>/dev/null || true
        fi
        # Refresh the desktop database so the installed .desktop entry is
        # picked up by menus, launchers, and file associations.
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        # Refresh the hicolor icon theme cache so the GAIA icon renders in
        # the launcher immediately after install.
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
