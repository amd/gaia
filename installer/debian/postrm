#!/bin/sh
# GAIA Agent UI — Debian post-remove script.
#
# Package removal and purge preserve per-user data. Users opt in to
# personal-data cleanup through `gaia uninstall --purge`.
#
# See docs/plans/desktop-installer.mdx §5.1 and §7 Phase E.

set -e

remove_desktop_link() {
    # Remove only the link created by postinst. Leave an unrelated file or
    # replacement symlink at this path untouched.
    if [ -L /usr/bin/gaia-desktop ] &&
       [ "$(readlink /usr/bin/gaia-desktop)" = "/opt/GAIA/gaia-desktop" ]; then
        rm -f /usr/bin/gaia-desktop
    fi
}

case "$1" in
    remove)
        remove_desktop_link
        ;;
    purge)
        remove_desktop_link
        # Refresh the desktop database + icon cache after the files have
        # been removed so stale entries disappear from menus.
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi

        echo 'Per-user data remains in ~/.gaia; run ~/.gaia/venv/bin/gaia uninstall --purge to remove it.'
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
