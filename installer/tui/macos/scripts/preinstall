#!/bin/bash
# Runs before the payload lands. The package deliberately carries NO directory
# entry for /usr/local or /usr/local/bin — installing one resets that directory
# to root:wheel and breaks Homebrew on an Intel Mac. Create whichever is missing
# here instead: mkdir -p leaves an existing directory, and its ownership, alone.
set -euo pipefail

# $2 is the INSTALL LOCATION, not the volume ($3 is) — it equals "/" only
# because pkgbuild ran with --install-location "/". Changing that flag in
# build-pkg.sh must change this line with it.
DEST_ROOT="${2:-/}"

for dir in usr/local/bin usr/local/share/doc/gaia-tui; do
    path="${DEST_ROOT%/}/${dir}"
    if [ ! -d "$path" ]; then
        mkdir -p "$path" || {
            echo "GAIA install failed: could not create ${path}." >&2
            echo "Create it by hand ('sudo mkdir -p ${path}') and re-run the installer." >&2
            exit 1
        }
        chmod 0755 "$path"
    fi
done
