  "phase_meanings": {
    "download": "Downloading the installer from the GitHub release; network-bound",
    "install": "Silent install of the downloaded installer until it exits",
    "upgrade": "Upgrade from the previous stable release",
    "launch": "Desktop app: process start plus the journey's fixed 10 s liveness wait. Terminal: gaia-tui version",
    "health": "Desktop app: first launch until GET /api/health answers, which includes building ~/.gaia/venv from PyPI (uv + amd-gaia[ui]) and the backend's cold start; gaia init skipped (GAIA_SKIP_GAIA_INIT), polled every 3 s. Terminal: one non-interactive turn through the installed gaia-agent against a fake model server, so agent cold start plus one turn",
    "preflight": "Terminal: the same turn with no model server, which must refuse and name the fix within 120 s",
    "quit": "Desktop app: stopping the app and its backend",
    "uninstall": "Silent uninstall",
    "leftovers": "Checking nothing is left behind after uninstall"
  },
