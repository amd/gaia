    "src/gaia/apps/*/webui"
  ],
  "devDependencies": {
    "electron": "^45.2.3"
  },
  "overrides": {
    "tar": ">=7.5.8",
    "find-my-way": ">=9.7.0",
    "lodash": ">=4.18.0"
  }
}
