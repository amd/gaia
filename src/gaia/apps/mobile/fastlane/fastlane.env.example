# Copy this file outside the repository, fill it in, and source it before a lane:
#   set -a; . /path/to/your/fastlane.env; set +a
# Placeholders only. Never commit real values.

# Signing (ios device)
GAIA_APPLE_TEAM_ID=your-team-id
GAIA_ASC_KEY_ID=your-key-id
GAIA_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
GAIA_ASC_KEY_PATH=/path/to/your-api-key.p8
GAIA_MATCH_GIT_URL=git@example.com:your-org/your-match-repo.git
GAIA_MATCH_GIT_BRANCH=main
GAIA_MATCH_PASSWORD=change-me

# Bundle ids: the ones app.config.ts builds for APP_ENV=production and development
GAIA_IOS_BUNDLE_ID=com.example.gaia
GAIA_IOS_BUNDLE_ID_DEV=com.example.gaia.dev

# The iPhone (ios device register_device:true, ios sideload), from `xcrun devicectl list devices`
GAIA_IOS_DEVICE=00000000-0000-0000-0000-000000000000

# Optional
# GAIA_MOBILE_APP_DIR=/path/to/gaia/src/gaia/apps/mobile
# GAIA_IOS_BUILD_DIR=/path/to/build/output
FASTLANE_OPT_OUT_USAGE=YES
FASTLANE_SKIP_UPDATE_CHECK=1
