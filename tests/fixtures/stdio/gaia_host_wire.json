{
  "_comment": "The wire `gaiacpp --engine` speaks with a host program: JSON Lines on stdin and stdout. The engine's tests and both SDKs' tests are checked against this file, so a change here is a protocol change.",
  "protocol": 1,
  "host_to_engine": {
    "init": {
      "required": ["type", "protocol", "model", "base_url"],
      "optional": [
        "api_key_env",
        "system_prompt",
        "tools",
        "max_steps",
        "max_output_tokens",
        "context_size",
        "temperature",
        "native_tools",
        "retries",
        "prices",
        "gate_model_calls"
      ]
    },
    "turn": {
      "required": ["type", "id", "messages"],
      "optional": ["budget"]
    },
    "tool_result": {
      "required": ["type", "id"],
      "one_of": ["result", "error"]
    },
    "model_go": {
      "required": ["type", "id"],
      "optional": ["stop"]
    },
    "cancel": {
      "required": ["type"]
    },
    "shutdown": {
      "required": ["type"]
    }
  },
  "tool": {
    "required": ["name"],
    "optional": ["description", "parameters", "max_calls_per_turn", "terminal"]
  },
  "budget": ["model_calls", "output_tokens", "seconds", "usd"],
  "prices": ["input", "cached_input", "output"],
  "engine_to_host": {
    "ready": ["type", "protocol", "version"],
    "tool_request": ["type", "id", "turn", "name", "arguments"],
    "model_request": [
      "type",
      "id",
      "turn",
      "model_calls",
      "input_tokens",
      "output_tokens",
      "seconds",
      "seconds_left"
    ],
    "model_call": ["type", "turn", "step", "seconds", "usage"],
    "final": [
      "type",
      "turn",
      "status",
      "stop_reason",
      "text",
      "tool_calls",
      "usage",
      "cost_usd",
      "seconds",
      "failure",
      "host_stop"
    ],
    "error": ["type", "code", "message"]
  },
  "tool_call": ["name", "arguments", "result", "failed"],
  "usage": ["model_calls", "input_tokens", "cached_tokens", "output_tokens"],
  "model_call_usage": ["input_tokens", "cached_tokens", "output_tokens"],
  "status": ["success", "incomplete", "failed", "cancelled"],
  "stop_reason": [
    "answered",
    "max_steps",
    "model_calls",
    "output_tokens",
    "deadline",
    "cost",
    "host_stop",
    "model_call",
    "repeated_calls",
    "no_answer",
    "incomplete",
    "cancelled"
  ],
  "error_code": ["bad_init", "bad_message", "bad_turn", "engine_error"]
}
