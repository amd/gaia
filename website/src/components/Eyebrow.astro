// Mono uppercase section eyebrow. `pill` wraps it in a bordered pill with a
// glowing gold dot (the hero / page-title treatment).
interface Props {
  class?: string;
  pill?: boolean;
}
const { class: className = '', pill = false } = Astro.props;
---

{pill ? (
  <div class={`g-pill-eyebrow ${className}`}>
    <span class="g-dot" aria-hidden="true"></span>
    <span class="g-eyebrow"><slot /></span>
  </div>
) : (
  <div class={`g-eyebrow ${className}`}><slot /></div>
)}
