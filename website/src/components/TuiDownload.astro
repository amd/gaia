// Direct download of the agent's terminal entry point, OS-detected.
//
// Every published platform is rendered server-side, so a no-JS visitor gets the
// whole list and a working link. JS promotes the one this machine can run into
// the primary button and collapses the rest; a machine it cannot place
// (Apple Silicon behind Safari, an unknown arch) keeps the full list rather
// than guessing — see scripts/download-target.ts.
//
// The binary is the raw artifact, not an installer: it needs the `gaia` CLI for
// the local model. That caveat lives in the page's terminal-install section
// rather than under the button, which stays a single uncluttered action.

import { getComponentRelease } from '../data/catalog';
import { PLATFORM_LABELS, type PlatformKey } from '../scripts/download-target';

interface Props {
  class?: string;
  align?: 'left' | 'center';
}

const { class: className = '', align = 'left' } = Astro.props;
const centered = align === 'center';

const release = await getComponentRelease('terminal-hub');

// Order the list the way a visitor scans for their own machine.
const ORDER: PlatformKey[] = [
  'win-x64',
  'darwin-arm64',
  'linux-x64',
  'win-arm64',
  'darwin-x64',
  'linux-arm64',
];

const platformOf = (filename: string): PlatformKey =>
  filename.replace(/^gaia-/, '').replace(/\.exe$/, '') as PlatformKey;

const downloads = release.binaries
  .map((b) => ({ ...b, platform: platformOf(b.filename) }))
  .filter((b) => b.platform in PLATFORM_LABELS)
  .sort((a, b) => ORDER.indexOf(a.platform) - ORDER.indexOf(b.platform));
---

<div class:list={['min-w-0', centered && 'flex flex-col items-center text-center', className]} data-tui-download>
  <div class:list={['flex flex-wrap items-center gap-3', centered && 'justify-center']}>
    {/* The resolved-platform CTA. Hidden until JS places the machine — with no
        JS the list below is the whole interface. */}
    <a
      data-dl-primary
      hidden
      href={downloads[0]?.url}
      class="g-btn g-btn-primary px-6 py-3 text-[15px]"
    >
      <svg class="h-4 w-4 flex-none" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span data-dl-label>Install the GAIA agent</span>
    </a>
  </div>

  <div data-dl-list class="mt-4">
    <div class="g-label mb-2.5" data-dl-list-label>Download for your platform · v{release.version}</div>
    <ul class:list={['grid gap-x-6 gap-y-1.5 sm:grid-cols-2', centered && 'justify-items-center']}>
      {downloads.map((d) => (
        <li>
          <a
            href={d.url}
            data-dl-option
            data-platform={d.platform}
            class="group inline-flex items-baseline gap-2 text-[13.5px] text-g-muted transition-colors hover:text-g-gold-text"
          >
            <span class="text-g-gold-text" aria-hidden="true">↓</span>
            <span>{PLATFORM_LABELS[d.platform]}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

</div>

<script>
  import { resolvePlatform, PLATFORM_LABELS } from '../scripts/download-target';

  document.querySelectorAll<HTMLElement>('[data-tui-download]').forEach(async (root) => {
    const options = Array.from(
      root.querySelectorAll<HTMLAnchorElement>('[data-dl-option]')
    );
    if (!options.length) return;

    const platform = await resolvePlatform(navigator).catch(() => null);
    if (!platform) return;   // Unplaceable machine: the full list stays as-is.

    const match = options.find((o) => o.dataset.platform === platform);
    if (!match) return;      // A platform the hub does not publish for.

    const primary = root.querySelector<HTMLAnchorElement>('[data-dl-primary]');
    const label = root.querySelector('[data-dl-label]');
    if (!primary || !label) return;

    primary.href = match.href;
    label.textContent = `Install GAIA for ${PLATFORM_LABELS[platform]}`;
    primary.hidden = false;

    // The other platforms stay reachable, one disclosure away.
    const list = root.querySelector<HTMLElement>('[data-dl-list]');
    const listLabel = root.querySelector('[data-dl-list-label]');
    if (!list || !listLabel) return;
    const details = document.createElement('details');
    details.className = 'mt-4';
    const summary = document.createElement('summary');
    summary.className =
      'g-label cursor-pointer list-none transition-colors hover:text-g-text';
    summary.textContent = `Other platforms · v${listLabel.textContent?.split('v').pop() ?? ''}`;
    list.replaceWith(details);
    details.append(summary, list);
    listLabel.remove();
  });
</script>
