---
// Copyright(C) 2024-2026 Advanced Micro Devices, Inc. All rights reserved.
// SPDX-License-Identifier: MIT

const currentYear = new Date().getFullYear();

// Discord stays the INVITE link, not the README's channel deep link — a
// channels/… URL only resolves for people already in the server.
const LINKS = [
  { label: 'Agent Hub', href: '/hub' },
  { label: 'Docs', href: 'https://amd-gaia.ai/docs', external: true },
  { label: 'GitHub', href: 'https://github.com/amd/gaia', external: true },
  { label: 'Discord', href: 'https://discord.com/invite/5xXzkMu8Zk', external: true },
];
---

<footer class="border-t border-g-border bg-g-bg2">
  <div class="g-shell flex flex-col gap-6 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex items-baseline gap-2">
        <span class="font-display text-[18px] font-semibold tracking-[-0.02em] text-g-text">GAIA</span>
        <span class="mono text-[10px] text-g-faint">/ AMD</span>
      </div>
      <p class="mt-2 text-[12.5px] text-g-faint">
        MIT License &bull; &copy; 2024-{currentYear} Advanced Micro Devices, Inc.
      </p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-7 gap-y-2">
      {LINKS.map((l) => (
        <a
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener noreferrer' : undefined}
          class="text-[13px] text-g-muted transition-colors hover:text-g-text"
        >{l.label}</a>
      ))}
    </nav>
  </div>
</footer>
