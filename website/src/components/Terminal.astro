// Hero terminal: a scripted terminal-hub session that types on character by
// character. The transcript is rendered server-side, so no-JS and
// prefers-reduced-motion visitors get the whole session statically.
//
// The session is ILLUSTRATIVE, not captured output — the commands (gaia init,
// gaia-tui) and the stream event types (status / tool_call / final) are real,
// the document and its findings are invented. That is why the chrome says so.

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// [text, class]. Classes are the .log-* / .tok-* spans scoped to .g-code-panel.
type Segment = [string, string];

const LINES: Segment[][] = [
  [['$ ', 'tok-key'], ['gaia init', '']],
  [['✦ Gemma-4-E4B-it-GGUF ready · local runtime up', 'log-dim']],
  [['$ ', 'tok-key'], ['gaia-tui', '']],
  [['◆ GAIA terminal hub · agents on this machine', 'tok-key']],
  [['› ', 'tok-key'], ['what should I flag in ~/reports/q3-forecast.pdf?', '']],
  [['[status] ', 'log-dim'], ['indexing q3-forecast.pdf · on-device', '']],
  [['[tool_call] ', 'log-dim'], ['rag.query · retrieving relevant pages', '']],
  [['  RISK    ', 'log-urgent'], ['Supply constraint flagged in section 4', '']],
  [['  RISK    ', 'log-needs'], ['FX assumption unchanged since Q1', '']],
  [['  NOTE    ', 'log-fyi'], ['Margin outlook revised upward', 'log-dim']],
  [['[tool_call] ', 'log-dim'], ['memory.save · remembered for next session', '']],
  [['[final] ', 'log-ok'], ['answered locally — the file never left this machine', 'log-ok']],
];

const escChar = (c: string) =>
  c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c;

// Leading spaces and space runs become &nbsp; so the severity column stays
// aligned; single interior spaces stay breakable so long lines still wrap.
const renderLine = (segments: Segment[]) => {
  let prev = '';
  return segments
    .map(([text, cls]) => {
      let out = '';
      for (const ch of text) {
        out += ch === ' ' && (prev === '' || prev === ' ') ? '&nbsp;' : escChar(ch);
        prev = ch;
      }
      return `<span class="${cls}">${out}</span>`;
    })
    .join('');
};

// The cursor is aria-hidden: now that the transcript is exposed to assistive
// tech, a block glyph read as "▊" is noise. Kept in sync with paint() below.
const transcript = `${LINES.map(renderLine).join('<br>')}<span class="tok-key" aria-hidden="true">▊</span>`;
---

<div
  class:list={[
    'g-code-panel border-g-border2 shadow-g-terminal transition-all duration-[400ms] ease-g-out hover:-translate-y-1 hover:border-g-gold-dim hover:shadow-g-card',
    className,
  ]}
>
  <div class="g-code-chrome">
    <span class="h-[11px] w-[11px] rounded-full bg-white/10" aria-hidden="true"></span>
    <span class="h-[11px] w-[11px] rounded-full bg-white/10" aria-hidden="true"></span>
    <span class="h-[11px] w-[11px] rounded-full bg-white/10" aria-hidden="true"></span>
    <span class="mono ml-1.5 text-[11.5px] text-g-code-faint">gaia-tui · illustrative</span>
    <span class="mono ml-auto rounded-g-badge border border-g-gold-dim px-1.5 py-0.5 text-[10px] uppercase tracking-[0.08em] text-g-gold">local</span>
  </div>

  {/* The box scrolls (the transcript is taller than 268px, much taller when it
      wraps on a phone), so it must be focusable to be keyboard-scrollable — and
      it must not be role="img", which would hide the transcript, including the
      "never left this machine" payoff, from assistive tech. */}
  <div
    data-terminal
    data-lines={JSON.stringify(LINES)}
    tabindex="0"
    role="region"
    aria-label="Illustrative terminal session — a scripted terminal-hub demo, not captured output."
    class="mono h-[268px] overflow-y-auto px-[18px] pb-[22px] pt-[18px] text-[13px] leading-[1.85] text-g-code-text"
    set:html={transcript}
  />
</div>

<script>
  type Segment = [string, string];

  const CHAR_PROMPT_MS = 26;
  const CHAR_OUTPUT_MS = 12;
  const LINE_GAP_MS = 260;
  const RESTART_MS = 3800;

  const escChar = (c: string) =>
    c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c;

  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((el) => {
    // Reduced motion keeps the server-rendered transcript exactly as-is.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const lines: Segment[][] = JSON.parse(el.dataset.lines || '[]');
    if (!lines.length) return;

    // The server-rendered transcript, complete. Restored the moment the region
    // takes focus so a keyboard or screen-reader user reads the whole session
    // instead of whatever prefix the loop happens to be on.
    const fullHtml = el.innerHTML;

    let lineIdx = 0;
    let segIdx = 0;
    let charIdx = 0;
    let built = '';
    let prevChar = '';
    let timer = 0;

    const isPromptLine = (line: Segment[]) => {
      const head = line[0]?.[0] ?? '';
      return head.startsWith('$') || head.startsWith('›');
    };

    const paint = () => {
      el.innerHTML = `${built}<span class="tok-key" aria-hidden="true">▊</span>`;
      el.scrollTop = el.scrollHeight;
    };

    const tick = () => {
      if (lineIdx >= lines.length) {
        timer = window.setTimeout(() => {
          lineIdx = 0;
          segIdx = 0;
          charIdx = 0;
          built = '';
          prevChar = '';
          tick();
        }, RESTART_MS);
        return;
      }

      const line = lines[lineIdx];

      if (segIdx >= line.length) {
        built += '<br>';
        lineIdx += 1;
        segIdx = 0;
        charIdx = 0;
        prevChar = '';
        paint();
        timer = window.setTimeout(tick, LINE_GAP_MS);
        return;
      }

      const [text, cls] = line[segIdx];
      if (charIdx === 0) built += `<span class="${cls}">`;

      if (charIdx < text.length) {
        const ch = text[charIdx];
        built += ch === ' ' && (prevChar === '' || prevChar === ' ') ? '&nbsp;' : escChar(ch);
        prevChar = ch;
        charIdx += 1;
        paint();
        timer = window.setTimeout(tick, isPromptLine(line) ? CHAR_PROMPT_MS : CHAR_OUTPUT_MS);
        return;
      }

      built += '</span>';
      segIdx += 1;
      charIdx = 0;
      tick();
    };

    built = '';
    paint();
    timer = window.setTimeout(tick, 600);

    el.addEventListener('focus', () => {
      // Keyboard visits only — a stray mouse click must not kill the demo.
      if (!el.matches(':focus-visible')) return;
      clearTimeout(timer);
      el.innerHTML = fullHtml;
      el.scrollTop = 0;
    });

    window.addEventListener('pagehide', () => clearTimeout(timer));
  });
</script>
