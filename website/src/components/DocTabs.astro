// Tablist for the agent-detail doc panels. Presentational only — the roving
// tabindex / arrow-key controller and the panels themselves live on the page
// that owns them (pages/hub/[id].astro), so the ids below must stay in sync
// with its `docpanel-*` panels.

interface Tab {
  key: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  label: string;
}

const { tabs, label } = Astro.props;
---

<div
  role="tablist"
  aria-label={label}
  class="flex gap-0.5 overflow-x-auto border-b border-g-border px-2"
>
  {tabs.map((t, i) => (
    <button
      type="button"
      role="tab"
      id={`doctab-${t.key}`}
      aria-controls={`docpanel-${t.key}`}
      data-doc-tab={t.key}
      aria-selected={i === 0 ? 'true' : 'false'}
      tabindex={i === 0 ? 0 : -1}
      class="doc-tab"
    >{t.label}</button>
  ))}
</div>

<style is:global>
  .doc-tab {
    @apply -mb-px flex-none whitespace-nowrap border-b-2 border-transparent px-3.5 py-3.5 font-mono text-[12px] uppercase tracking-[0.06em] text-g-faint transition-colors duration-[250ms] ease-g-out hover:text-g-text;
  }
  .doc-tab[aria-selected='true'] {
    @apply border-g-gold text-g-gold-text;
  }
</style>
