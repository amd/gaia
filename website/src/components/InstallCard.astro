// Agent-detail install card: the manifest-driven command (via InstallMethods),
// the runtime prerequisite, and the two follow-on links. Every fact here comes
// from the catalog — nothing about a specific agent is written into the markup.

import InstallMethods from './InstallMethods.astro';
import { formatBytes, installCta, isNpmSidecar, languageLabel, type Agent } from '../data/catalog';

interface Props {
  agent: Agent;
}

const { agent } = Astro.props;

// The sidecar wording belongs to the agent lane only — see isNpmSidecar.
const isSidecar = isNpmSidecar(agent);
const npmUrl = agent.npm_package ? `https://www.npmjs.com/package/${agent.npm_package}` : '';
const deepLink = `gaia://hub/install/${agent.id}`;
const cta = installCta(agent);

const size = agent.download_size_bytes > 0 ? formatBytes(agent.download_size_bytes) : '';
const meta = [
  isSidecar ? 'npm client + frozen sidecar' : `${languageLabel(agent.language)} package`,
  size,
].filter(Boolean).join(' · ');
---

<section class="g-card p-6" aria-labelledby="install-heading">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
    <h2 id="install-heading" class="g-h-card">Install</h2>
    {meta && <span class="mono text-[11px] text-g-faint">{meta}</span>}
  </div>

  <InstallMethods agent={agent} />

  <p class="mt-3.5 text-[13px] leading-[1.6] text-g-faint">
    {isSidecar && (
      <span>Ships as an npm client plus a frozen binary sidecar — GAIA is the recommended install path (there is no PyPI wheel). The npm package is for embedding the agent in a JS/TS app. </span>
    )}
    A local model must be running first: <span class="mono text-g-muted">gaia init</span> then <span class="mono text-g-muted">lemonade-server serve</span>.
  </p>

  <div class="mt-[18px] flex flex-wrap gap-3">
    {cta === 'npm' ? (
      <a href={npmUrl} target="_blank" rel="noopener" class="g-btn g-btn-primary">View on npm</a>
    ) : cta === 'gaia+npm' ? (
      <>
        <a href={deepLink} class="g-btn g-btn-primary">Open in GAIA</a>
        <a href={npmUrl} target="_blank" rel="noopener" class="g-btn g-btn-secondary">View on npm</a>
      </>
    ) : (
      <a href={deepLink} class="g-btn g-btn-primary">Open in GAIA</a>
    )}
    {/* The catalog carries no per-agent docs URL, so this points at the guides
        index rather than guessing a /guides/<id> path that may not exist. */}
    <a href="https://amd-gaia.ai/docs/guides" target="_blank" rel="noopener" class="g-btn g-btn-secondary">Docs &amp; guides</a>
  </div>
</section>
