// Row of mono figures: 30px numeral over an 11px uppercase label, 36px apart.
interface Props {
  stats: { value: string; label: string }[];
  class?: string;
}

const { stats, class: className = '' } = Astro.props;
---

<div class={`flex flex-wrap gap-x-9 gap-y-5 ${className}`}>
  {stats.map((stat) => (
    <div>
      <div class="mono text-[26px] font-medium leading-none tracking-[-0.02em] text-g-text sm:text-[30px]">
        {stat.value}
      </div>
      <div class="g-label mt-[7px]">{stat.label}</div>
    </div>
  ))}
</div>
