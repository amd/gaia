// Row of figures: a 44px Antonio numeral over a 12.5px uppercase label.
interface Props {
  stats: { value: string; label: string }[];
  class?: string;
}

const { stats, class: className = '' } = Astro.props;
---

<div class={`flex flex-wrap gap-x-9 gap-y-5 ${className}`}>
  {stats.map((stat) => (
    <div>
      <div class="font-display text-[36px] font-semibold leading-none tracking-[0.01em] text-g-text sm:text-[44px]">
        {stat.value}
      </div>
      <div class="g-label mt-[7px]">{stat.label}</div>
    </div>
  ))}
</div>
