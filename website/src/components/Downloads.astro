// The two ways to get GAIA, side by side: the desktop app and the terminal.
//
// They are two front ends onto the same local agent, not two products, so the
// page's job is to let a visitor pick in one read rather than explain the
// architecture. Each card says what the thing IS and who it is for; the
// download itself is resolved for this machine.
//
// Platform coverage is NOT symmetric and the cards say so. The terminal hub
// builds all six ({win,darwin,linux} x {x64,arm64}); the desktop app builds
// three. A machine with no desktop build is TOLD that, and pointed at the
// terminal — never shown a disabled button, a dead link, or wording that
// implies a build is on the way.
//
// Every platform renders server-side, so a visitor with no JS gets the full
// list below and a working link for both surfaces. JS reveals the block for
// the machine it can place; a Mac behind Safari reports no architecture and so
// matches BOTH Mac blocks (which is why the desktop card reads "Apple Silicon
// download" and "no Intel build" together there), and a machine it cannot
// place at all keeps the full list rather than guessing.
//
// A machine JS can place gets one primary download at the top instead of two
// cards to choose between, with that platform's other files folded under it:
// the desktop app wherever it builds, the terminal app where it does not, and
// on Windows x64 (from WINDOWS_SETUP_SINCE) the setup that installs the desktop
// app, the terminal app, or both. A release missing a platform's primary file
// gives that platform no primary button -- never another file promoted in its
// place.
//
// Every link is an asset of the newest stable GitHub release, so GitHub's
// per-asset download_count counts the site's downloads. No link is invented: a
// key resolves to an exact asset name, that name has to be on the release, and
// the href is that asset's own browser_download_url. A platform the release
// carries no asset for is therefore absent rather than a dead link.

import SurfacePreview from './SurfacePreview.astro';
import { formatBytes, getStableRelease, type ReleaseAsset } from '../data/github';
import {
  WINDOWS_INSTALL_COMMAND,
  DESKTOP_DOWNLOAD_LABELS,
  DESKTOP_MISSING_PLATFORMS,
  DESKTOP_PLATFORMS,
  DOWNLOAD_LABELS,
  INSTALLERS_FOR,
  INSTALLER_CTA_LABELS,
  PLATFORM_LABELS,
  PLATFORM_ORDER,
  artifactFileName,
  desktopArtifactFileName,
  desktopExtraFileNames,
  windowsSetupOffersChoice,
  type DownloadKey,
  type InstallerKey,
  type PlatformKey,
} from '../scripts/download-target';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const release = await getStableRelease();
const { version } = release;

// Key -> exact asset name -> the asset the release actually carries. The reverse
// direction does not work: a release also carries wheels, blockmaps and
// checksum files, and deriving a platform from a name that carries a version
// silently drops assets.
const byName = new Map(release.assets.map((a) => [a.name, a]));
const published = (name: string | null) => (name ? byName.get(name) : undefined);

const desktopRows = DESKTOP_PLATFORMS.flatMap((platform) => {
  const artifact = published(desktopArtifactFileName(platform, version));
  return artifact ? [{ platform, artifact }] : [];
});

interface TuiRow {
  platform: PlatformKey;
  binary: ReleaseAsset | undefined;
  installers: { key: InstallerKey; artifact: ReleaseAsset }[];
}

const tuiRow = (platform: PlatformKey): TuiRow => ({
  platform,
  binary: published(artifactFileName(platform, version)),
  installers: INSTALLERS_FOR[platform].flatMap((key) => {
    const artifact = published(artifactFileName(key as DownloadKey, version));
    return artifact ? [{ key, artifact }] : [];
  }),
});

const tuiRows = PLATFORM_ORDER.map(tuiRow).filter((r) => r.binary || r.installers.length);

// A single platform missing is a coverage decision the page renders around. A
// whole card with nothing to offer is not: the asset names drifted (or this is
// not the release it looks like), and the card would quietly render with no
// download at all.
if (!desktopRows.length) {
  throw new Error(
    `[downloads] ${release.tag} carries ${release.assets.length} assets, none of which is a ` +
      `desktop app build (${DESKTOP_PLATFORMS.map((p) => desktopArtifactFileName(p, version)).join(', ')}). ` +
      `Check https://github.com/amd/gaia/releases/tag/${release.tag}; if the names changed, ` +
      `update DESKTOP_FILENAMES in src/scripts/download-target.ts.`,
  );
}
if (!tuiRows.length) {
  throw new Error(
    `[downloads] ${release.tag} carries ${release.assets.length} assets, none of which is a ` +
      `terminal build (${PLATFORM_ORDER.map((p) => artifactFileName(p, version)).join(', ')}). ` +
      `Check https://github.com/amd/gaia/releases/tag/${release.tag}; if the names changed, ` +
      `update BINARY_FILENAMES in src/scripts/download-target.ts.`,
  );
}

// Whether this release's win-x64-setup is the setup that asks desktop app /
// terminal / both, rather than the terminal-only one earlier releases used the
// same filename for.
const windowsCombined = windowsSetupOffersChoice(version);
const windowsSetup = windowsCombined
  ? tuiRow('win-x64').installers.find((i) => i.key === 'win-x64-setup')?.artifact
  : undefined;

// ---- The primary download, one per platform ----
//
// Each row is the one button a placed visitor sees, plus the files folded under
// it. Every file is looked up on the release; a missing primary file drops the
// row, and a missing option drops just that option.

interface Choice {
  asset: ReleaseAsset;
  label: string;
  note?: string;
  command?: string;
}

interface PrimaryRow {
  platform: PlatformKey;
  // What the button installs: the Windows setup, the desktop app, or the terminal.
  kind: 'setup' | 'desktop' | 'terminal';
  asset: ReleaseAsset;
  cta: string;
  caption: string;
  lede: string;
  options: Choice[];
}

const BINARY_NOTE = 'A single file with no installer: put it on your PATH yourself.';

const terminalChoices = (row: TuiRow): Choice[] => [
  ...row.installers.map((i) => ({ asset: i.artifact, label: `Terminal app — ${DOWNLOAD_LABELS[i.key]}` })),
  ...(row.binary
    ? [{ asset: row.binary, label: `Terminal app — ${DOWNLOAD_LABELS[row.platform]}`, note: BINARY_NOTE }]
    : []),
];

function primaryRow(platform: PlatformKey): PrimaryRow | null {
  const label = PLATFORM_LABELS[platform];
  const tui = tuiRow(platform);

  if (platform === 'win-x64' && windowsCombined) {
    if (!windowsSetup) return null;
    const desktopOnly = published(desktopArtifactFileName(platform, version));
    const options: Choice[] = [];
    if (desktopOnly) {
      options.push({
        asset: desktopOnly,
        label: 'Desktop app only (.exe)',
        note: 'Installs just the desktop app. It downloads the GAIA agent the first time it runs.',
      });
    }
    if (tui.binary) {
      options.push({
        asset: tui.binary,
        label: 'Terminal app only (.exe)',
        note: 'The terminal app as a single file, with no installer: put it on your PATH yourself. Or let PowerShell install it for you:',
        command: WINDOWS_INSTALL_COMMAND,
      });
    }
    return {
      platform,
      kind: 'setup',
      asset: windowsSetup,
      cta: INSTALLER_CTA_LABELS['win-x64-setup'],
      caption: 'Installer (.exe)',
      lede: 'One installer: it installs the desktop app, the terminal app, or both, and asks which while it runs. Both share the same local models.',
      options,
    };
  }

  const desktopName = desktopArtifactFileName(platform, version);
  if (desktopName) {
    const desktop = published(desktopName);
    if (!desktop) return null;
    const extras = desktopExtraFileNames(platform, version).flatMap(({ label: l, name }) => {
      const asset = published(name);
      return asset ? [{ asset, label: l }] : [];
    });
    const terminal = terminalChoices(tui);
    return {
      platform,
      kind: 'desktop',
      asset: desktop,
      cta: `Download for ${label}`,
      caption: `Desktop app — ${DESKTOP_DOWNLOAD_LABELS[platform]}`,
      lede:
        'The GAIA desktop app: chat, your documents and your files, with every step shown as it runs.' +
        (terminal.length ? ' The terminal app is under more options.' : ''),
      options: [...extras, ...terminal],
    };
  }

  // No desktop build here: the terminal app is the primary download.
  const [first, ...rest] = terminalChoices(tui);
  if (!first) return null;
  return {
    platform,
    kind: 'terminal',
    asset: first.asset,
    cta: `Download for ${label}`,
    caption: first.label,
    lede: `There is no desktop app for ${label}, so this is the GAIA terminal app.${first.note ? ` ${first.note}` : ''}`,
    options: rest,
  };
}

const primaryRows = PLATFORM_ORDER.flatMap((p) => primaryRow(p) ?? []);

// Neither card offers Windows x64 a button: the setup is where that choice is
// made, and a release without the setup offers no Windows button rather than a
// single-app file in its place. The terminal's Windows row in the full list
// keeps only its raw binary, since the setup has a line of its own there.
const isWindowsX64 = (p: PlatformKey) => p === 'win-x64';
const desktopCtaRows = windowsCombined ? desktopRows.filter((r) => !isWindowsX64(r.platform)) : desktopRows;
const tuiCtaRows = windowsCombined ? tuiRows.filter((r) => !isWindowsX64(r.platform)) : tuiRows;
const tuiListRows = windowsCombined
  ? tuiRows.map((r) => (isWindowsX64(r.platform) ? { ...r, installers: [] } : r))
  : tuiRows;
const desktopListLabel = (p: PlatformKey) =>
  windowsCombined && isWindowsX64(p) ? 'Desktop app only (.exe)' : DESKTOP_DOWNLOAD_LABELS[p];

// Until a release publishes installers none of these exist — a valid state, and
// the terminal card is the binary offer it was before. Naming the architectures
// that have no installer only makes sense once some architecture has one.
const anyInstaller = tuiRows.some((r) => r.installers.length > 0);

// "a, b or c" — the missing-desktop platforms read as a sentence, not a list.
const joinWithOr = (parts: string[]): string =>
  parts.length <= 1
    ? (parts[0] ?? '')
    : `${parts.slice(0, -1).join(', ')} or ${parts[parts.length - 1]}`;

const noDesktopFor = joinWithOr(DESKTOP_MISSING_PLATFORMS.map((p) => PLATFORM_LABELS[p]));

const DOWNLOAD_ICON = `<svg class="h-4 w-4 flex-none" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;
---

<div data-downloads class:list={['w-full min-w-0', className]}>
  {/* The two cards are options within this one region, not page sections. The
      heading names the region so they can sit under it as h3 instead of peer to
      the page's own headings. */}
  <h2 class="sr-only">Get GAIA</h2>

  {/* The primary download. Revealed with the block for this machine, and then
      the two cards below are hidden: they would offer the same files again.
      A plain wrapper carries `hidden` for the same reason as the cards. A Mac
      whose architecture cannot be read reveals both Mac blocks, Apple Silicon
      first; space-y-6 keeps them apart. */}
  {primaryRows.length > 0 && (
    <div data-dl-primary hidden>
      <section class="g-card mx-auto w-full max-w-[720px] p-[26px] text-left">
        <div data-dl-previews class="mb-5 grid gap-3 sm:grid-cols-2">
          <div data-dl-preview="agent-ui">
            <SurfacePreview surface="agent-ui" alt="The GAIA desktop app answering a question about an employee handbook." />
          </div>
          <div data-dl-preview="tui">
            <SurfacePreview surface="tui" alt="The GAIA terminal app writing a short Python function." />
          </div>
        </div>
        <div class="space-y-6">
          {primaryRows.map((row) => (
            <div
              data-dl-cta
              data-surface="primary"
              data-kind={row.kind}
              data-platform={row.platform}
              hidden
            >
              <h3 class="g-h-card">GAIA for {PLATFORM_LABELS[row.platform]}</h3>
              <p class="g-body mt-2.5">{row.lede}</p>
              <div class="mt-5">
                <a href={row.asset.url} class="g-btn g-btn-primary px-5 py-3 text-[15px]">
                  <Fragment set:html={DOWNLOAD_ICON} />
                  <span>{row.cta}</span>
                </a>
                <p class="g-body mt-2.5 text-[13px]">
                  {row.caption} · v{version} · {formatBytes(row.asset.sizeBytes)}
                </p>
              </div>

              {/* Folded away like the full list below: for a visitor who
                  already knows they want a different file. */}
              {row.options.length > 0 && (
                <details data-dl-options class="group mt-5">
                  <summary class="g-label inline-flex cursor-pointer list-none items-center gap-2 py-1 transition-colors hover:text-g-text [&::-webkit-details-marker]:hidden">
                    <span aria-hidden="true" class="inline-block transition-transform group-open:rotate-90">›</span>
                    {row.kind === 'setup' ? 'More options: just one app' : 'More options'}
                  </summary>
                  <ul class="mt-3 space-y-3">
                    {row.options.map((o) => (
                      <li data-dl-option>
                        <a
                          href={o.asset.url}
                          aria-label={`${o.label} for ${PLATFORM_LABELS[row.platform]}`}
                          class="inline-flex items-baseline gap-2 text-[13.5px] text-g-text transition-colors hover:text-g-accent-text"
                        >
                          <span class="text-g-accent-text" aria-hidden="true">↓</span>
                          <span>{o.label} · {formatBytes(o.asset.sizeBytes)}</span>
                        </a>
                        {o.note && <p class="g-body mt-1 text-[13px]">{o.note}</p>}
                        {o.command && (
                          <code class="mt-1.5 block overflow-x-auto whitespace-nowrap text-[12.5px] text-g-text">{o.command}</code>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          ))}
        </div>
      </section>
    </div>
  )}

  {/* A plain wrapper carries `hidden`: the grid's own display class would
      override the attribute. */}
  <div data-dl-cards>
  <div class="mx-auto grid w-full max-w-[720px] gap-[18px] text-left sm:grid-cols-2">
    {/* ---- Desktop app ---- */}
    <section class="g-card p-[26px]">
      <SurfacePreview
        surface="agent-ui"
        alt="The GAIA desktop app answering a question about an employee handbook, with each step it takes shown as it runs."
        class="mb-5"
      />
      <h3 class="g-h-card">GAIA Agent UI</h3>
      <p class="g-body mt-2.5">
        A window you open like any other app. Chat, your documents and your files, with
        every tool call shown as it runs. Start here if you have not used GAIA before.
      </p>

      {/* space-y-3, not a margin per block: Tailwind's rule only pairs
          siblings that are BOTH un-hidden, and on Safari two blocks are
          revealed at once (the Apple Silicon download and the "no Intel
          build" line) with nothing between them otherwise. */}
      <div class="mt-5 space-y-3">
        {desktopCtaRows.map((row) => (
          <div data-dl-cta data-surface="desktop" data-kind="build" data-platform={row.platform} hidden>
            <a href={row.artifact.url} class="g-btn g-btn-primary px-5 py-3 text-[15px]">
              <Fragment set:html={DOWNLOAD_ICON} />
              <span>Download for {PLATFORM_LABELS[row.platform]}</span>
            </a>
            <p class="g-body mt-2.5 text-[13px]">
              {DESKTOP_DOWNLOAD_LABELS[row.platform]} · v{version} ·{' '}
              {formatBytes(row.artifact.sizeBytes)}
            </p>
          </div>
        ))}

        {/* Told plainly, and pointed somewhere that works. The app publishes no
            build for these three, so there is nothing to wait for. */}
        {DESKTOP_MISSING_PLATFORMS.map((platform) => (
          <div data-dl-cta data-surface="desktop" data-kind="none" data-platform={platform} hidden>
            <p class="g-body text-[13.5px]">
              There is no desktop build for {PLATFORM_LABELS[platform]}. The terminal runs
              there — take that one instead.
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* ---- Terminal ---- */}
    <section class="g-card p-[26px]">
      <SurfacePreview
        surface="tui"
        alt="The GAIA terminal app writing a short Python function, with the code syntax-highlighted."
        class="mb-5"
      />
      <h3 class="g-h-card">GAIA Terminal UI</h3>
      <p class="g-body mt-2.5">
        The same agent in your shell, on every platform GAIA builds for. Start here if you
        work over SSH, or would rather stay in a terminal.
      </p>

      <div class="mt-5">
        {/* Same reason as the desktop card: a Safari Mac reveals the Apple
            Silicon and Intel blocks together. The captions stay outside so
            they keep their tighter gap to the block they describe. */}
        <div class="space-y-3">
          {tuiCtaRows.map((row) => (
            <div
              data-dl-cta
              data-surface="tui"
              data-kind={row.installers.length ? 'installer' : 'binary'}
              data-platform={row.platform}
              hidden
            >
              <div class="flex flex-wrap items-center gap-3">
                {/* One installer reads like the desktop card's button, so two cards
                    side by side do not offer "Download" against "Install GAIA" for
                    the same machine. Linux keeps its package-format labels. */}
                {row.installers.length > 0
                  ? row.installers.map((i) => (
                      <a href={i.artifact.url} class="g-btn g-btn-primary px-5 py-3 text-[15px]">
                        <Fragment set:html={DOWNLOAD_ICON} />
                        <span>
                          {row.installers.length > 1
                            ? INSTALLER_CTA_LABELS[i.key]
                            : `Download for ${PLATFORM_LABELS[row.platform]}`}
                        </span>
                      </a>
                    ))
                  : row.binary && (
                      <a href={row.binary.url} class="g-btn g-btn-primary px-5 py-3 text-[15px]">
                        <Fragment set:html={DOWNLOAD_ICON} />
                        <span>Download for {PLATFORM_LABELS[row.platform]}</span>
                      </a>
                    )}
              </div>
            </div>
          ))}
        </div>

        {/* One caption per kind, at card level: with two Mac blocks revealed at
            once, a caption inside each would say the same thing twice. */}
        <p data-dl-note="installer" class="g-body mt-2.5 text-[13px]" hidden>
          Installs the agent and puts <code class="text-g-text">gaia-tui</code> on your PATH.
          v{version}.
        </p>
        <p data-dl-note="binary" class="g-body mt-2.5 text-[13px]" hidden>
          {anyInstaller
            ? 'No installer is published for this architecture, so this is the standalone binary — put it on your PATH yourself.'
            : 'The standalone binary — put it on your PATH and run gaia-tui.'}
          {' '}v{version}.
        </p>
      </div>
    </section>
  </div>
  </div>

  {/* Every download, both surfaces, grouped so each version and each coverage
      gap is stated once beside the thing it applies to. Rendered open; JS folds
      it away once a machine has been placed. */}
  <div data-dl-list class="mx-auto mt-8 w-full max-w-[720px] text-left">
    <div class="g-label mb-3" data-dl-list-label>Download for your platform</div>

    {windowsSetup && (
      <div class="mb-7">
        <div class="text-[13.5px] font-semibold text-g-text">
          Windows · desktop app, terminal, or both · v{version}
        </div>
        <ul class="mt-1.5 space-y-1">
          <li>
            <a
              href={windowsSetup.url}
              aria-label={`GAIA setup for ${PLATFORM_LABELS['win-x64']}: desktop app, terminal, or both`}
              class="inline-flex items-baseline gap-2 text-[13.5px] text-g-muted transition-colors hover:text-g-accent-text"
            >
              <span class="text-g-accent-text" aria-hidden="true">↓</span>
              <span>
                {PLATFORM_LABELS['win-x64']} — Installer (.exe) · {formatBytes(windowsSetup.sizeBytes)}
              </span>
            </a>
          </li>
        </ul>
      </div>
    )}

    <div class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
      <div>
        <div class="text-[13.5px] font-semibold text-g-text">
          Desktop app · v{version}
        </div>
        <ul class="mt-1.5 space-y-1">
          {desktopRows.map((row) => (
            <li>
              <a
                href={row.artifact.url}
                class="inline-flex items-baseline gap-2 text-[13.5px] text-g-muted transition-colors hover:text-g-accent-text"
              >
                <span class="text-g-accent-text" aria-hidden="true">↓</span>
                <span>
                  {PLATFORM_LABELS[row.platform]} — {desktopListLabel(row.platform)} ·{' '}
                  {formatBytes(row.artifact.sizeBytes)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        {noDesktopFor && (
          <p class="g-body mt-2 text-[12.5px]">No desktop build for {noDesktopFor}.</p>
        )}
      </div>

      <div>
        <div class="text-[13.5px] font-semibold text-g-text">Terminal · v{version}</div>
        <ul class="mt-1.5 space-y-1">
          {tuiListRows.map((row) => (
            <li>
              <div class="text-[13.5px] text-g-muted">
                {PLATFORM_LABELS[row.platform]}
                <span class="ml-2 inline-flex flex-wrap gap-x-3">
                  {[
                    ...row.installers.map((i) => ({
                      href: i.artifact.url,
                      label: DOWNLOAD_LABELS[i.key],
                    })),
                    ...(row.binary
                      ? [{ href: row.binary.url, label: DOWNLOAD_LABELS[row.platform] }]
                      : []),
                  ].map((o) => (
                    /* The platform stays visible once per row — a platform can
                       carry three links and printing it three times is worse to
                       scan. aria-label puts it back into each link's NAME, so a
                       links list does not read six identical "Standalone
                       binary" entries. */
                    <a
                      href={o.href}
                      aria-label={`${o.label} for ${PLATFORM_LABELS[row.platform]}`}
                      class="inline-flex items-baseline gap-1.5 transition-colors hover:text-g-accent-text"
                    >
                      <span class="text-g-accent-text" aria-hidden="true">↓</span>
                      <span>{o.label}</span>
                    </a>
                  ))}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  import { resolveTargets } from '../scripts/download-target';

  document.querySelectorAll<HTMLElement>('[data-downloads]').forEach(async (root) => {
    const blocks = Array.from(root.querySelectorAll<HTMLElement>('[data-dl-cta]'));
    if (!blocks.length) return;

    const targets = await resolveTargets(navigator).catch(() => []);
    // An unplaceable machine — an iPad sending the Mac UA, an unreadable arch —
    // keeps the full list open rather than being shown a guess.
    const forMachine = blocks.filter((b) => targets.includes(b.dataset.platform as never));
    const primary = forMachine.filter((b) => b.dataset.surface === 'primary');
    // The primary download when this machine has one, the cards otherwise.
    const matched = primary.length ? primary : forMachine;
    if (!matched.length) return;

    for (const block of matched) block.hidden = false;

    if (primary.length) {
      const wrapper = root.querySelector<HTMLElement>('[data-dl-primary]');
      if (wrapper) wrapper.hidden = false;
      const cards = root.querySelector<HTMLElement>('[data-dl-cards]');
      if (cards) cards.hidden = true;
      // Only the terminal app on offer: no desktop screenshot beside it.
      if (primary.every((b) => b.dataset.kind === 'terminal')) {
        root.querySelector<HTMLElement>('[data-dl-preview="agent-ui"]')?.setAttribute('hidden', '');
        root.querySelector('[data-dl-previews]')?.classList.remove('sm:grid-cols-2');
      }
    }

    // The captions live at card level, so reveal the ones whose kind is now on
    // screen. Two Mac blocks can share a caption; that is the point of it.
    const kinds = new Set(matched.map((b) => b.dataset.kind));
    root.querySelectorAll<HTMLElement>('[data-dl-note]').forEach((note) => {
      if (kinds.has(note.dataset.dlNote)) note.hidden = false;
    });

    // Every platform stays one disclosure away, including this machine's other
    // options — so someone who came for the standalone binary still finds it.
    const list = root.querySelector<HTMLElement>('[data-dl-list]');
    const listLabel = root.querySelector('[data-dl-list-label]');
    if (!list || !listLabel) return;
    const details = document.createElement('details');
    details.className = 'group mx-auto mt-8 w-full max-w-[720px] text-left';
    const summary = document.createElement('summary');
    summary.className =
      'g-label inline-flex cursor-pointer list-none items-center gap-2 py-1 transition-colors hover:text-g-text [&::-webkit-details-marker]:hidden';
    const chevron = document.createElement('span');
    chevron.setAttribute('aria-hidden', 'true');
    chevron.className = 'inline-block transition-transform group-open:rotate-90';
    chevron.textContent = '›';
    summary.append(chevron, 'Other platforms and formats');
    list.replaceWith(details);
    details.append(summary, list);
    list.classList.replace('mt-8', 'mt-4');
    listLabel.remove();
  });
</script>
