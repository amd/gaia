// Titled code panel for hand-authored snippets. Code is passed as segments
// ([text, class]) rather than slot markup: Astro collapses the whitespace
// around expressions in a slot, which silently eats the line breaks a <pre>
// depends on. Classes are the .tok-* spans scoped to .g-code-panel.
// The panel is dark in both themes — that is what g-code-bg is for.

type Segment = [string, string];

interface Props {
  title: string;
  lines: Segment[][];
  class?: string;
}

const { title, lines, class: className = '' } = Astro.props;

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const code = lines
  .map((segments) =>
    segments.map(([text, cls]) => (cls ? `<span class="${cls}">${esc(text)}</span>` : esc(text))).join('')
  )
  .join('\n');
---

<div
  class:list={[
    'g-code-panel border-g-border2 transition-all duration-[400ms] ease-g-out hover:-translate-y-1 hover:border-g-gold-dim hover:shadow-g-card',
    className,
  ]}
>
  <div class="mono border-b border-g-border px-3.5 py-2.5 text-[11.5px] text-g-code-faint">{title}</div>
  {/* Focusable because it scrolls horizontally. role="group" rather than
      "region" so N panels on a page don't become N landmarks; group still
      carries the name a focusable scroll container needs. */}
  <pre
    tabindex="0"
    role="group"
    aria-label={title}
    class="mono m-0 overflow-x-auto px-[18px] py-4 text-[12.5px] leading-[1.75] text-g-code-text"
    set:html={code}
  />
</div>
