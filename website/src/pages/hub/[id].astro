import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgentIcon from '../../components/AgentIcon.astro';
import InstallCard from '../../components/InstallCard.astro';
import DocTabs from '../../components/DocTabs.astro';
import SidebarCard from '../../components/SidebarCard.astro';
import FileTree from '../../components/FileTree.astro';
import {
  getCatalog,
  getAgent,
  categoryLabel,
  languageLabel,
  securityTierLabel,
  securityTierDescription,
  formatBytes,
  platformLabel,
  npuLabel,
} from '../../data/catalog';
import { buildFileTree } from '../../data/fileTree';
import { renderMarkdown } from '../../data/markdown';

export async function getStaticPaths() {
  const agents = await getCatalog();
  return agents.map((a) => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const agent = (await getAgent(id!))!;

const isNpm = !!agent.npm_package;
const readmeHtml = renderMarkdown(agent.readme);
// Optional docs — older index.json (served before the hub Worker adds a field) may
// lack these; render a tab only when there's content.
const changelogHtml = agent.changelog ? renderMarkdown(agent.changelog) : '';
const specHtml = agent.spec ? renderMarkdown(agent.spec) : '';
const skillHtml = agent.skill ? renderMarkdown(agent.skill) : '';
const evaluationHtml = agent.evaluation ? renderMarkdown(agent.evaluation) : '';
const capabilityMatrixHtml = agent.capability_matrix ? renderMarkdown(agent.capability_matrix) : '';
// Eval scorecard: the Worker embeds the SCORECARD.md body (front matter already
// stripped) as `scorecard`, and the aggregate as `eval_score`. Render the body as
// a tab; the score card links out to the canonical source (eval_scorecard_url).
const scorecardHtml = agent.scorecard ? renderMarkdown(agent.scorecard) : '';
const hasScore = typeof agent.eval_score === 'number';
// Clamp display precision to 2 dp so an unrounded upstream aggregate (e.g.
// 84.66666667) can't render a long decimal; already-clean values (84.67) are
// unchanged.
const scoreDisplay = typeof agent.eval_score === 'number'
  ? Math.round(agent.eval_score * 100) / 100
  : undefined;
const scorePct = typeof agent.eval_score === 'number'
  ? Math.max(0, Math.min(100, agent.eval_score))
  : 0;
const req = agent.requirements;

const packageFiles = agent.package?.files ?? [];
const topLevelFolders = new Set(
  packageFiles.filter((f) => f.name.includes('/')).map((f) => f.name.split('/')[0])
).size;

// Details "Size" is a RANGE across the per-platform binaries (they differ by
// OS/arch), computed from the package listing's binaries/ entries. Falls back to
// the primary artifact size when no package zip listing is available.
const binarySizes = packageFiles
  .filter((f) => f.name.startsWith('binaries/'))
  .map((f) => f.size_bytes);
const sizeMin = binarySizes.length ? Math.min(...binarySizes) : agent.download_size_bytes;
const sizeMax = binarySizes.length ? Math.max(...binarySizes) : agent.download_size_bytes;

// File browser: a nested, collapsible tree of the package contents. Text files
// link to their content on the npm CDN (jsdelivr) for inline preview; the zip's
// binaries aren't on the CDN and aren't text, so they stay non-clickable.
const previewBase = agent.npm_package
  ? `https://cdn.jsdelivr.net/npm/${agent.npm_package}@${agent.latest_version}/`
  : null;
const fileTree = buildFileTree(packageFiles, previewBase);

// Doc tabs that actually have content (README is always present). The Files tab is
// the package's directory listing; it only appears once a whole-package zip ships.
const docTabs = [
  { key: 'readme', label: 'Readme' },
  ...(specHtml ? [{ key: 'spec', label: 'Spec' }] : []),
  ...(skillHtml ? [{ key: 'skill', label: 'Skill' }] : []),
  ...(evaluationHtml ? [{ key: 'evaluation', label: 'Evaluation' }] : []),
  ...(capabilityMatrixHtml ? [{ key: 'capability_matrix', label: 'Capabilities' }] : []),
  ...(changelogHtml ? [{ key: 'changelog', label: 'Changelog' }] : []),
  ...(scorecardHtml ? [{ key: 'scorecard', label: 'Scorecard' }] : []),
  ...(packageFiles.length ? [{ key: 'files', label: 'Files' }] : []),
];

// A lone Readme needs no tablist — and with no tabs rendered, the panel must not
// claim a tabpanel role pointing at a `doctab-readme` that doesn't exist.
const hasTabs = docTabs.length > 1;

const detailRows = [
  { label: 'Version', value: agent.latest_version },
  ...(sizeMax > 0
    ? [{ label: 'Size', value: sizeMin === sizeMax ? formatBytes(sizeMax) : `${formatBytes(sizeMin)} – ${formatBytes(sizeMax)}` }]
    : []),
  { label: 'Author', value: agent.author },
  { label: 'Category', value: categoryLabel(agent.category) },
  {
    label: 'Language',
    value: languageLabel(agent.language),
    // npm/binary agents ship a self-contained compiled binary — no Python
    // runtime on the host, so "Python" alone is misleading.
    note: isNpm ? 'Ships as a native binary — no Python needed' : undefined,
  },
  ...(agent.tools_count > 0 ? [{ label: 'Tools', value: String(agent.tools_count) }] : []),
  ...(agent.npm_package ? [{ label: 'Package', value: agent.npm_package }] : []),
];

const requirementRows = [
  ...(req.min_memory_gb > 0 ? [{ label: 'Memory', value: `${req.min_memory_gb} GB` }] : []),
  ...(req.min_disk_gb > 0 ? [{ label: 'Disk', value: `${req.min_disk_gb} GB` }] : []),
  ...(req.min_context_size > 0 ? [{ label: 'Context', value: req.min_context_size.toLocaleString() }] : []),
  ...(req.gpu_vram_gb > 0 ? [{ label: 'GPU VRAM', value: `${req.gpu_vram_gb} GB` }] : []),
  { label: 'NPU', value: npuLabel(req.npu) },
  ...(agent.min_gaia_version ? [{ label: 'Min GAIA', value: agent.min_gaia_version }] : []),
  ...(req.platforms.length ? [{ label: 'Platforms', value: req.platforms.map(platformLabel).join(' · ') }] : []),
];
---

<Layout title={`${agent.name} — Agent Hub — gaia`} description={agent.description}>
  <Header />
  <main id="main-content" class="g-shell pb-24 pt-[110px]">

    <nav class="mono mb-[30px] flex items-center gap-2.5 text-[12px] text-g-faint" aria-label="Breadcrumb">
      <a href="/hub" class="text-g-muted transition-colors hover:text-g-gold-text">Agent Hub</a>
      <span aria-hidden="true">/</span>
      <span class="text-g-text">{agent.id}</span>
    </nav>

    <!-- Title block + eval score -->
    <div class="animate-g-rise flex flex-wrap items-start justify-between gap-8">
      <div class="min-w-0 flex-1 basis-[460px]">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
          <span class="g-chip h-[52px] w-[52px] rounded-g-chip-lg border-g-border2">
            <AgentIcon name={agent.icon} class="h-[25px] w-[25px]" />
          </span>
          <h1 class="g-h-agent">{agent.name}</h1>
          <span class="mono text-[13px] text-g-faint">v{agent.latest_version}</span>
          <span class="g-badge inline-flex items-center gap-1.5 px-2 py-[3px]">
            {agent.security_tier === 'verified' && (
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            )}
            {securityTierLabel(agent.security_tier)}
          </span>
        </div>

        <p class="mt-[18px] max-w-[600px] text-[17px] leading-[1.65] text-g-muted">{agent.description}</p>

        {agent.deprecated && (
          <p class="mt-4 max-w-[600px] rounded-g-panel border border-g-border2 px-3.5 py-2.5 text-[13px] text-g-muted">
            Deprecated{agent.deprecation_message ? ` — ${agent.deprecation_message}` : ''}
          </p>
        )}

        {agent.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2.5">
            {agent.tags.map((t) => <li class="g-pill-static">{t}</li>)}
          </ul>
        )}
      </div>

      {hasScore && (
        <!-- Eval score: the aggregate parsed from the published scorecard, with a
             jump to the full scorecard tab and the canonical source. -->
        <div class="g-card w-full border-g-border2 p-[22px] sm:w-auto sm:min-w-[280px]">
          <h2 class="g-label">Eval score</h2>
          <div class="mt-2.5 flex items-baseline gap-[7px]">
            <span class="mono text-[44px] font-medium leading-none tracking-[-0.03em] text-g-gold-text">{scoreDisplay}</span>
            <span class="mono text-[14px] text-g-faint">/ 100</span>
          </div>
          <div class="mt-3.5 h-[5px] overflow-hidden rounded-[3px] bg-g-surface2">
            <div class="h-full rounded-[3px] bg-gradient-to-r from-g-gold to-g-gold2" style={`width:${scorePct}%`}></div>
          </div>
          <p class="mt-3.5 max-w-[280px] text-[12.5px] leading-[1.55] text-g-faint">
            Aggregate benchmark score for the latest published version — the methodology and every sub-metric are in the scorecard.
          </p>
          <div class="mt-3.5 flex flex-wrap items-center gap-x-5 gap-y-2">
            {scorecardHtml && (
              <button type="button" data-doc-goto="scorecard" class="g-cta-link">Read the scorecard →</button>
            )}
            {agent.eval_scorecard_url && (
              <a href={agent.eval_scorecard_url} target="_blank" rel="noopener" class="g-cta-link">Source ↗</a>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- Install + tabbed docs, with the metadata sidebar -->
    <div class="mt-11 grid grid-cols-1 items-start gap-7 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="min-w-0" data-doc-tabs>
        <InstallCard agent={agent} />

        <!-- scroll-mt clears the fixed 66px header when a [data-doc-goto] link jumps here. -->
        <div id="docs" class="g-card mt-6 scroll-mt-[86px] overflow-hidden">
          {hasTabs && <DocTabs tabs={docTabs} label={`${agent.name} documentation`} />}

          <div class="px-6 py-7">
            <article
              role={hasTabs ? 'tabpanel' : undefined}
              aria-labelledby={hasTabs ? 'doctab-readme' : undefined}
              id="docpanel-readme"
              data-doc-panel="readme"
              class="doc max-w-[70ch]"
            >
              <h2 class="sr-only">About {agent.name}</h2>
              <div set:html={readmeHtml} />
            </article>
            {specHtml && (
              <article role="tabpanel" id="docpanel-spec" aria-labelledby="doctab-spec" data-doc-panel="spec" class="doc max-w-[70ch]" hidden>
                <div set:html={specHtml} />
              </article>
            )}
            {skillHtml && (
              <article role="tabpanel" id="docpanel-skill" aria-labelledby="doctab-skill" data-doc-panel="skill" class="doc max-w-[70ch]" hidden>
                <div set:html={skillHtml} />
              </article>
            )}
            {evaluationHtml && (
              <article role="tabpanel" id="docpanel-evaluation" aria-labelledby="doctab-evaluation" data-doc-panel="evaluation" class="doc max-w-[70ch]" hidden>
                <div set:html={evaluationHtml} />
              </article>
            )}
            {capabilityMatrixHtml && (
              <article role="tabpanel" id="docpanel-capability_matrix" aria-labelledby="doctab-capability_matrix" data-doc-panel="capability_matrix" class="doc max-w-[70ch]" hidden>
                <div set:html={capabilityMatrixHtml} />
              </article>
            )}
            {changelogHtml && (
              <article role="tabpanel" id="docpanel-changelog" aria-labelledby="doctab-changelog" data-doc-panel="changelog" class="doc max-w-[70ch]" hidden>
                <div set:html={changelogHtml} />
              </article>
            )}
            {scorecardHtml && (
              <article role="tabpanel" id="docpanel-scorecard" aria-labelledby="doctab-scorecard" data-doc-panel="scorecard" class="doc max-w-[70ch]" hidden>
                {agent.eval_scorecard_url && (
                  <p class="text-[13px] text-g-faint">
                    {hasScore && <span>Aggregate score <strong class="text-g-text">{scoreDisplay} / 100</strong>. </span>}
                    <a href={agent.eval_scorecard_url} target="_blank" rel="noopener">View the canonical scorecard ↗</a>
                  </p>
                )}
                <div set:html={scorecardHtml} />
              </article>
            )}
            {packageFiles.length > 0 && (
              <section role="tabpanel" id="docpanel-files" aria-labelledby="doctab-files" data-doc-panel="files" hidden>
                <h2 class="g-h-card">Package contents</h2>
                <div class="mb-4 mt-2 flex flex-wrap items-center justify-between gap-3">
                  <p class="text-[13px] text-g-faint">
                    {packageFiles.length} files across {topLevelFolders} {topLevelFolders === 1 ? 'folder' : 'folders'}{previewBase ? ' — click a text file to preview it.' : '.'}
                  </p>
                  <div class="flex flex-none gap-1.5 text-[11px]" data-file-tree-controls>
                    <button type="button" data-files-expand class="rounded-g-badge border border-g-border px-2 py-1 text-g-muted transition-colors hover:border-g-gold-dim hover:text-g-text">Expand all</button>
                    <button type="button" data-files-collapse class="rounded-g-badge border border-g-border px-2 py-1 text-g-muted transition-colors hover:border-g-gold-dim hover:text-g-text">Collapse all</button>
                  </div>
                </div>
                <div class="file-tree rounded-g-panel border border-g-border p-3 font-mono text-[12.5px]" data-file-tree>
                  <FileTree nodes={fileTree.children} />
                </div>
              </section>
            )}
          </div>
        </div>
      </div>

      <aside class="flex flex-col gap-[18px]">
        <SidebarCard title="Details" rows={detailRows} />
        <SidebarCard title="Requirements" rows={requirementRows} />

        {agent.permissions.length > 0 && (
          <SidebarCard title="Permissions">
            <ul class="flex flex-col gap-2.5">
              {agent.permissions.map((p) => (
                <li class="grid grid-cols-[auto_1fr] items-baseline gap-2.5">
                  <span class="text-[11px] text-g-gold-text" aria-hidden="true">◆</span>
                  <span class="mono text-[12px] leading-[1.5] text-g-muted">{p}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-[12px] leading-[1.55] text-g-faint">
              Declared in the agent's manifest for v{agent.latest_version} — the full set it can request.
            </p>
          </SidebarCard>
        )}

        <SidebarCard title="Security tier">
          <span class="g-badge">{securityTierLabel(agent.security_tier)}</span>
          <p class="mt-3 text-[12.5px] leading-[1.55] text-g-faint">{securityTierDescription(agent.security_tier)}</p>
        </SidebarCard>

        {agent.models.length > 0 && (
          <SidebarCard title="Models">
            <ul class="mono flex flex-col gap-1.5 text-[12px] text-g-muted">
              {agent.models.map((m) => <li>{m}</li>)}
            </ul>
          </SidebarCard>
        )}

        {agent.package && packageFiles.length > 0 && (
          <!-- Gated on files.length too so the "Browse the contents" jump always
               has a Files tab to land on. -->
          <SidebarCard title="Package">
            <p class="text-[12.5px] leading-[1.55] text-g-faint">
              The client, docs, and every platform binary — {packageFiles.length} files in all.
            </p>
            <button type="button" data-doc-goto="files" class="g-cta-link mt-3">Browse the contents →</button>
          </SidebarCard>
        )}

        {agent.playground_url && isNpm && (
          <!-- Playground launcher: one command to fetch+run the sidecar, then a
               button that goes live once the local sidecar is reachable. -->
          <div data-playground data-playground-url={agent.playground_url}>
            <SidebarCard title="Playground">
              <p class="text-[12.5px] leading-[1.55] text-g-faint">
                Run the sidecar and open the interactive playground in one command:
              </p>
              <button
                type="button"
                data-pg-copy={`npx ${agent.npm_package} playground`}
                aria-label={`Copy command: npx ${agent.npm_package} playground`}
                class="g-cmd pg-copy group mt-2.5 w-full border-g-border text-left transition-colors hover:border-g-gold-dim"
              >
                <span class="select-none text-g-gold" aria-hidden="true">$</span>
                <span data-pg-cmd class="min-w-0 flex-1 truncate">npx {agent.npm_package} playground</span>
                <span class="pg-copy-label flex-none select-none text-[11px] text-g-code-text/70 group-hover:text-g-gold">copy</span>
              </button>
              <p data-pg-copy-status class="sr-only" role="status"></p>
              <a
                href={agent.playground_url}
                target="_blank"
                rel="noopener"
                data-pg-open
                aria-disabled="true"
                aria-describedby="pg-status"
                class="mt-2.5 flex items-center justify-center rounded-g-btn border border-g-border px-4 py-2 text-[13px] font-medium text-g-faint transition-colors"
              >
                Open playground
              </a>
              {/* role="status": the sidecar coming up, and a blocked click, are
                  both silent otherwise. aria-describedby ties the reason the
                  link is disabled to the link itself. */}
              <p id="pg-status" data-pg-status role="status" class="mt-2.5 text-[11px] text-g-faint">Checking if it's running…</p>
            </SidebarCard>
          </div>
        )}
      </aside>
    </div>

  </main>
  <Footer />

  <!-- Fullscreen image lightbox for rendered doc diagrams. -->
  <div
    id="doc-lightbox"
    class="fixed inset-0 z-[100] hidden cursor-zoom-out items-center justify-center bg-black/90 p-6 backdrop-blur-sm focus:outline-none"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview (press Escape to close)"
    tabindex="-1"
  >
    <img id="doc-lightbox-img" src="" alt="" class="max-h-full max-w-full rounded-g-panel shadow-2xl" />
  </div>

  <!-- File preview modal: shows the text content of a clicked package file. -->
  <div
    id="file-preview"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm sm:p-8"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="File preview (press Escape to close)"
  >
    <div class="flex max-h-full w-full max-w-3xl flex-col overflow-hidden rounded-g-card border border-g-border bg-g-bg shadow-g-terminal">
      <div class="flex flex-none items-center justify-between gap-3 border-b border-g-border bg-g-surface px-4 py-2.5">
        <span id="file-preview-name" class="truncate font-mono text-[13px] text-g-text"></span>
        <div class="flex flex-none items-center gap-3">
          <a id="file-preview-raw" href="#" target="_blank" rel="noopener" class="text-[11px] text-g-muted hover:text-g-gold-text">Raw ↗</a>
          <button type="button" id="file-preview-close" aria-label="Close preview" class="text-g-muted hover:text-g-text">✕</button>
        </div>
      </div>
      <div class="min-h-0 flex-1 overflow-auto">
        <pre class="!my-0 !rounded-none !border-0 bg-g-code-bg p-4 text-[12.5px] leading-relaxed"><code id="file-preview-code" class="!bg-transparent"></code></pre>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Prism from 'prismjs';
  import 'prismjs/components/prism-javascript';
  import 'prismjs/components/prism-typescript';
  import 'prismjs/components/prism-bash';
  import 'prismjs/components/prism-json';
  import 'prismjs/components/prism-yaml';
  import 'prismjs/components/prism-markdown';

  // Syntax-highlight rendered code blocks. The renderer emits
  // <code class="language-*">; Prism reads textContent (already HTML-escaped) and
  // restyles, so no new injection surface. Runs once for every doc tab panel.
  Prism.highlightAll();

  // Click any rendered doc image to view it fullscreen; click anywhere or press
  // Escape to close. Sources are already scheme-allowlisted by the markdown
  // renderer, so reusing img.src here carries no new injection surface.
  const box = document.getElementById('doc-lightbox');
  const boxImg = document.getElementById('doc-lightbox-img') as HTMLImageElement | null;
  if (box && boxImg) {
    let lastFocused: HTMLElement | null = null;
    const isOpen = () => !box.classList.contains('hidden');
    const open = (trigger: HTMLImageElement) => {
      lastFocused = trigger; // restore focus here on close
      boxImg.src = trigger.src;
      boxImg.alt = trigger.alt;
      box.classList.remove('hidden');
      box.classList.add('flex');
      box.setAttribute('aria-hidden', 'false');
      box.focus(); // move focus into the dialog
    };
    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      box.setAttribute('aria-hidden', 'true');
      boxImg.removeAttribute('src');
      lastFocused?.focus(); // restore focus to the image that opened it
    };
    // Only standalone diagrams are zoomable (matches the .doc p > img:only-child
    // CSS) — inline badges stay at natural size and aren't clickable. Make them
    // keyboard-operable (focusable + Enter/Space) since they're now interactive.
    document.querySelectorAll<HTMLImageElement>('.doc p > img:only-child').forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img); }
      });
    });
    box.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') close();
      // The dialog has no other focusable children, so trap Tab on the dialog.
      else if (e.key === 'Tab') { e.preventDefault(); box.focus(); }
    });
  }

  // Doc tabs: switch between the rendered doc panels. Mirrors the InstallMethods
  // tab pattern — roving tabindex + ArrowLeft/Right, ARIA-correct.
  const tabRoot = document.querySelector('[data-doc-tabs]');
  if (tabRoot) {
    const tabs = Array.from(tabRoot.querySelectorAll<HTMLButtonElement>('[data-doc-tab]'));
    const panels = Array.from(tabRoot.querySelectorAll<HTMLElement>('[data-doc-panel]'));
    const select = (key: string | null) => {
      for (const t of tabs) {
        const on = t.getAttribute('data-doc-tab') === key;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      for (const p of panels) p.hidden = p.getAttribute('data-doc-panel') !== key;
    };
    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => select(tab.getAttribute('data-doc-tab')));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(idx + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        select(next.getAttribute('data-doc-tab'));
        next.focus();
      });
    });

    // Cross-links elsewhere on the page (the score card, the Package card) that
    // jump to a specific doc tab and scroll it into view.
    const docsCard = document.getElementById('docs') ?? tabRoot;
    document.querySelectorAll<HTMLElement>('[data-doc-goto]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-doc-goto');
        select(key);
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        docsCard.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        tabs.find((t) => t.getAttribute('data-doc-tab') === key)?.focus();
      });
    });
  }

  // Playground card: copy the launch command, and probe the LOCAL sidecar so the
  // "Open playground" button only activates once it's actually running. The hub
  // is HTTPS but 127.0.0.1 is a trustworthy origin, so a no-cors liveness probe
  // is allowed (it resolves if something is listening, rejects if not) — we can't
  // read the response, but reachability is all we need.
  const pg = document.querySelector('[data-playground]');
  if (pg) {
    const copyBtn = pg.querySelector<HTMLButtonElement>('[data-pg-copy]');
    const copyStatus = pg.querySelector<HTMLElement>('[data-pg-copy-status]');
    let revert: number | undefined;
    copyBtn?.addEventListener('click', async () => {
      const label = copyBtn.querySelector('.pg-copy-label');
      const reset = (ms: number) => {
        clearTimeout(revert);
        revert = window.setTimeout(() => {
          if (label) label.textContent = 'copy';
          if (copyStatus) copyStatus.textContent = '';
        }, ms);
      };
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.pgCopy || '');
        if (label) label.textContent = 'copied';
        if (copyStatus) copyStatus.textContent = 'Command copied to the clipboard.';
        reset(1600);
      } catch {
        // Same non-secure-origin / permission case as InstallMethods: select the
        // command so "select & copy" is an instruction the page has honoured.
        if (label) label.textContent = 'select & copy';
        const cmd = copyBtn.querySelector('[data-pg-cmd]');
        if (cmd) {
          const range = document.createRange();
          range.selectNodeContents(cmd);
          const sel = getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        if (copyStatus) copyStatus.textContent = 'Copying was blocked. The command is selected — press Control or Command + C to copy it.';
        reset(2600);
      }
    });

    const open = pg.querySelector<HTMLAnchorElement>('[data-pg-open]');
    const status = pg.querySelector<HTMLElement>('[data-pg-status]');
    const pgUrl = pg.getAttribute('data-playground-url') || '';
    let healthUrl = '';
    try { healthUrl = new URL(pgUrl).origin + '/health'; } catch { /* invalid */ }

    // A blocked-click message survives a few idle polls, but never a real state
    // change — the status is the link's aria-describedby, so it must not claim
    // "can't open it yet" once the link has actually gone live.
    let holdUntil = 0;
    let lastUp: boolean | null = null;

    // Only write when the text actually changes: role="status" is polite-live,
    // and re-asserting the same string every 3s is what makes a region chatty.
    const say = (msg: string) => {
      if (status && status.textContent !== msg) status.textContent = msg;
    };

    const setRunning = (up: boolean, quiet = false) => {
      if (open) {
        open.setAttribute('aria-disabled', up ? 'false' : 'true');
        open.classList.toggle('border-g-gold-dim', up);
        open.classList.toggle('text-g-gold-text', up);
        open.classList.toggle('text-g-faint', !up);
        open.classList.toggle('border-g-border', !up);
      }
      const changed = up !== lastUp;
      lastUp = up;
      if (quiet) return;
      if (changed || Date.now() >= holdUntil) {
        say(up
          ? 'Running — opens in a new tab.'
          : 'Not running yet — run the command above, then this lights up.');
      }
    };
    // Style the link now, but leave "Checking if it's running…" up until the
    // first probe resolves rather than announcing a verdict we don't have yet.
    setRunning(false, true);

    // Block the click until the sidecar is up (avoids a confusing connection error).
    open?.addEventListener('click', (e) => {
      if (open.getAttribute('aria-disabled') === 'true') {
        e.preventDefault();
        copyBtn?.classList.add('animate-g-pulse');
        setTimeout(() => copyBtn?.classList.remove('animate-g-pulse'), 600);
        // The pulse is the only feedback a sighted user gets, and reduced motion
        // crushes it to nothing — so say it in text as well.
        holdUntil = Date.now() + 5000;
        say("Can't open it yet — copy the command above and run it first, then this link lights up.");
      }
    });

    if (healthUrl) {
      const probe = async () => {
        try {
          await fetch(healthUrl, { mode: 'no-cors', signal: AbortSignal.timeout(1500) });
          setRunning(true);
        } catch { setRunning(false); }
      };
      probe();
      setInterval(probe, 3000);
    }
  }

  // Files tab: expand/collapse-all toggles every folder <details> in the tree.
  const fileTreeEl = document.querySelector('[data-file-tree]');
  if (fileTreeEl) {
    const allDetails = () => Array.from(fileTreeEl.querySelectorAll<HTMLDetailsElement>('details'));
    document.querySelector('[data-files-expand]')?.addEventListener('click', () =>
      allDetails().forEach((d) => (d.open = true))
    );
    document.querySelector('[data-files-collapse]')?.addEventListener('click', () =>
      allDetails().forEach((d) => (d.open = false))
    );
  }

  // File preview: fetch a clicked text file's content from the CDN and show it in
  // a modal. Content is set as textContent (never innerHTML) and only highlighted
  // by Prism, so a file's bytes can't inject markup.
  const fp = document.getElementById('file-preview');
  const fpCode = document.getElementById('file-preview-code');
  const fpName = document.getElementById('file-preview-name');
  const fpRaw = document.getElementById('file-preview-raw') as HTMLAnchorElement | null;
  const fpClose = document.getElementById('file-preview-close');
  if (fp && fpCode && fpName && fpRaw) {
    let lastFocused: HTMLElement | null = null;
    const langByExt: Record<string, string> = {
      js: 'javascript', mjs: 'javascript', cjs: 'javascript', ts: 'typescript',
      tsx: 'typescript', json: 'json', yaml: 'yaml', yml: 'yaml', sh: 'bash',
      md: 'markdown', markdown: 'markdown',
    };
    const closeFp = () => {
      fp.classList.add('hidden');
      fp.classList.remove('flex');
      fp.setAttribute('aria-hidden', 'true');
      fpCode.textContent = '';
      lastFocused?.focus();
    };
    const openFp = async (url: string, name: string, trigger: HTMLElement) => {
      lastFocused = trigger;
      fpName.textContent = name;
      fpRaw.href = url;
      const ext = name.toLowerCase().split('.').pop() || '';
      const lang = langByExt[ext] || 'none';
      fpCode.className = `!bg-transparent language-${lang}`;
      fpCode.textContent = 'Loading…';
      fp.classList.remove('hidden');
      fp.classList.add('flex');
      fp.setAttribute('aria-hidden', 'false');
      (fpClose as HTMLElement | null)?.focus();
      try {
        const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
        if (!res.ok) throw new Error(String(res.status));
        const text = await res.text();
        // Guard against accidentally rendering a huge/binary file in the modal.
        fpCode.textContent = text.length > 500_000 ? text.slice(0, 500_000) + '\n…(truncated)' : text;
        Prism.highlightElement(fpCode);
      } catch {
        fpCode.className = '!bg-transparent';
        fpCode.textContent =
          `Preview unavailable for this file.\n\nIt may not be part of the published npm package ` +
          `(e.g. a platform binary), or this version isn't on the CDN yet. Use "Raw ↗" to try directly.`;
      }
    };
    document.querySelectorAll<HTMLButtonElement>('[data-file-preview]').forEach((btn) => {
      btn.addEventListener('click', () =>
        openFp(btn.dataset.filePreview || '', btn.dataset.fileName || 'file', btn)
      );
    });
    fpClose?.addEventListener('click', closeFp);
    fp.addEventListener('click', (e) => { if (e.target === fp) closeFp(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !fp.classList.contains('hidden')) closeFp();
    });
  }
</script>

<style is:global>
  /* Documentation prose theme for the rendered hub markdown (README, SPEC,
     SKILL, EVALUATION, CAPABILITY_MATRIX, CHANGELOG, SCORECARD). The markdown
     renderer emits classless semantic tags (website/src/data/markdown.ts) so
     this stylesheet is the single source of truth for how hub markdown looks.
     Every color is a token — code cards stay dark in both themes because
     g-code-bg / g-code-text are theme-invariant. */
  .doc { @apply text-[15px] leading-[1.75] text-g-text/90; }
  .doc > :first-child { @apply mt-0; }

  /* Shifted one level to match renderMarkdown's demotion (doc `#` emits <h2>), so
     the visual hierarchy is unchanged while the outline stays valid. */
  .doc h2 { @apply mt-0 mb-4 font-display text-[28px] font-semibold tracking-[-0.025em] text-g-text; }
  .doc h3 { @apply mt-10 mb-4 border-b border-g-border pb-2 font-display text-[20px] font-semibold tracking-[-0.015em] text-g-text; }
  .doc h4 { @apply mt-8 mb-3 font-display text-[16px] font-semibold text-g-text; }
  .doc h5 { @apply mt-6 mb-2 font-display text-[15px] font-semibold text-g-text; }

  .doc p { @apply my-4 leading-[1.75] text-g-text/90; }
  .doc strong { @apply font-semibold text-g-text; }
  .doc em { @apply italic; }
  .doc a { @apply font-medium text-g-gold-text underline decoration-g-gold/40 underline-offset-2 transition-colors hover:decoration-g-gold; }

  .doc ul { @apply my-4 list-disc space-y-2 pl-6 marker:text-g-faint; }
  .doc ol { @apply my-4 list-decimal space-y-2 pl-6 marker:text-g-faint; }
  .doc li { @apply leading-[1.7] text-g-text/90; }
  .doc li > ul, .doc li > ol { @apply my-2; }

  .doc code { @apply rounded-g-badge border border-g-border bg-g-surface2 px-1.5 py-0.5 font-mono text-[0.85em] text-g-text; }
  .doc pre { @apply my-5 overflow-x-auto rounded-g-panel border border-g-border bg-g-code-bg p-4; }
  .doc pre code { @apply border-0 bg-transparent p-0 font-mono text-[12.5px] leading-[1.8] text-g-code-text; }

  .doc table { @apply my-6 block w-full overflow-x-auto border-collapse text-left text-[14px]; }
  .doc th { @apply border-b border-g-border bg-g-surface2 px-3 py-2 text-left font-semibold text-g-text; }
  .doc td { @apply border-b border-g-border px-3 py-2 align-top text-g-text/85; }
  .doc tbody tr:last-child td { @apply border-0; }

  .doc blockquote { @apply my-5 border-l-2 border-g-gold-dim bg-g-surface2 px-4 py-2 italic text-g-muted; }
  /* Default image: natural size, capped to the column. Keeps inline badges
     (e.g. a shields.io version pill, which sits in a paragraph with other text)
     from being blown up to full width. */
  .doc img { @apply my-5 max-w-full rounded-g-panel border border-g-border; }
  /* A standalone image — the only child of its paragraph — is a diagram or
     screenshot: fill the column (they read small at natural size) and zoom to
     fullscreen on click (see the lightbox script above). */
  .doc p > img:only-child { @apply w-full cursor-zoom-in transition-colors hover:border-g-gold-dim; }
  .doc hr { @apply my-8 border-0 border-t border-g-border; }

  /* File tree (Files tab): native <details> collapse, custom chevron, no marker. */
  .file-tree summary { list-style: none; }
  .file-tree summary::-webkit-details-marker { display: none; }
  .file-tree summary:hover .file-tree-chevron { @apply text-g-text; }
  .file-tree-chevron { transition: transform 0.15s ease; }
  .file-tree details[open] > summary .file-tree-chevron { transform: rotate(90deg); }

  /* Prism syntax-highlight tokens, tuned for the dark code card (.doc pre). */
  .doc pre .token.comment,
  .doc pre .token.prolog,
  .doc pre .token.doctype,
  .doc pre .token.cdata { color: rgb(var(--g-code-faint)); font-style: italic; }
  .doc pre .token.punctuation { color: #9aa0aa; }
  .doc pre .token.keyword,
  .doc pre .token.boolean,
  .doc pre .token.atrule { color: #c792ea; }
  .doc pre .token.string,
  .doc pre .token.char,
  .doc pre .token.inserted,
  .doc pre .token.attr-value { color: #c3e88d; }
  .doc pre .token.function,
  .doc pre .token.class-name { color: #82aaff; }
  .doc pre .token.number,
  .doc pre .token.constant,
  .doc pre .token.symbol { color: #f78c6c; }
  .doc pre .token.property,
  .doc pre .token.tag,
  .doc pre .token.attr-name { color: #ffcb6b; }
  .doc pre .token.operator,
  .doc pre .token.entity,
  .doc pre .token.url { color: #89ddff; }
</style>
