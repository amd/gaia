import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import FeaturedCard from '../../components/FeaturedCard.astro';
import AgentRow from '../../components/AgentRow.astro';
import ComingSoonRow from '../../components/ComingSoonRow.astro';
import StatBlock from '../../components/StatBlock.astro';
import { getCatalog, categoryLabel, distinct } from '../../data/catalog';
import { getInDevelopmentAgents } from '../../data/inDevelopment';

const agents = await getCatalog();
const soon = getInDevelopmentAgents(agents.map((a) => a.id));

// Editorial pick: feature the email agent; fall back to the first non-deprecated
// verified agent, else the first agent.
const spotlight =
  agents.find((a) => a.id === 'email' && !a.deprecated) ??
  agents.find((a) => !a.deprecated && a.security_tier === 'verified') ??
  agents[0];
// Pills cover both groups — a category that only exists on coming-soon rows
// still needs a way to be filtered to.
const categories = [
  ...new Set([...distinct(agents, 'category'), ...soon.map((a) => a.category)]),
].sort();

const stats = [
  { value: String(agents.length), label: 'Published' },
  { value: String(soon.length), label: 'In development' },
  { value: '100%', label: 'On-device' },
];
---

<Layout title="Agent Hub — gaia" description="Browse and install local AI agents for GAIA.">
  <Header />
  <main id="main-content" class="g-shell pb-24 pt-[112px] sm:pt-[138px]">

    <Eyebrow pill class="mb-6">Agent Hub</Eyebrow>

    <div class="flex flex-wrap items-end justify-between gap-7">
      <div>
        <h1 class="g-h-page">Agents for<br />your machine.</h1>
        <p class="mt-[18px] max-w-[520px] text-[17px] leading-[1.6] text-g-muted">
          Each agent is purpose-built for one job, tested, and versioned.
          {agents.length === 1 ? ' One is' : ` ${agents.length} are`} published
          today — the rest are in development in the open, at
          <a
            href="https://github.com/amd/gaia/tree/main/hub/agents"
            target="_blank"
            rel="noopener noreferrer"
            class="prose-link"
          >hub/agents</a>.
        </p>
      </div>
      <StatBlock stats={stats} />
    </div>

    <!-- Featured spotlight (omitted when the catalog is empty, e.g. a sparse live hub) -->
    {spotlight && (
      <div class="mt-11">
        <FeaturedCard agent={spotlight} eyebrow="Featured" />
      </div>
    )}

    <!-- Filters -->
    <div class="mt-10 flex flex-wrap items-center gap-2.5 sm:mt-[52px]">
      <button type="button" data-filter="all" class="g-pill g-pill-active">All</button>
      {categories.map((c) => (
        <button type="button" data-filter={c} class="g-pill">{categoryLabel(c)}</button>
      ))}
      <label class="flex min-w-[250px] flex-1 items-center gap-2.5 rounded-g-btn border border-g-border bg-g-surface px-3.5 transition-colors focus-within:border-g-border2 hover:border-g-border2 sm:ml-auto sm:flex-none">
        <svg class="h-[15px] w-[15px] flex-none text-g-faint" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4.3-4.3"></path>
        </svg>
        <input
          id="hub-search"
          type="search"
          placeholder="Search agents…"
          aria-label="Search agents"
          class="mono w-full flex-1 border-0 bg-transparent py-[11px] text-[12.5px] text-g-text outline-none placeholder:text-g-faint"
        />
      </label>
    </div>

    <!-- Filter and search results change silently on screen, so they are
         announced here. -->
    <p id="hub-status" class="sr-only" role="status"></p>

    <!-- List. Both groups are real lists, so a screen reader announces how many
         agents there are instead of reading loose rows. -->
    <div id="hub-list" class="mt-[22px] overflow-hidden rounded-g-card border border-g-border bg-g-surface">
      <ul aria-label="Published agents">
        {agents.map((agent) => <li><AgentRow agent={agent} /></li>)}
      </ul>

      <div id="hub-no-published" class="hidden border-b border-g-border px-[22px] py-[30px] text-[13.5px] text-g-faint">
        No published agent matches your search.
      </div>

      <div id="hub-soon-divider" class="flex items-center gap-[11px] border-b border-g-border px-[22px] py-4">
        <h2 id="hub-soon-heading" class="g-label tracking-[0.14em]">In development</h2>
        <span class="h-px flex-1 bg-g-border" aria-hidden="true"></span>
        <span id="hub-soon-count" class="mono text-[11px] text-g-faint">
          {soon.length === 1 ? '1 agent' : `${soon.length} agents`}
        </span>
      </div>

      <ul aria-labelledby="hub-soon-heading">
        {soon.map((agent) => <li><ComingSoonRow agent={agent} /></li>)}
      </ul>

      <div id="hub-empty" class="hidden px-[22px] py-11 text-center text-[14px] text-g-muted">
        No agents match your search.
      </div>
    </div>

    <!-- Publish CTA -->
    <div class="mt-11 flex flex-wrap items-center justify-between gap-6 rounded-g-card border border-dashed border-g-border2 p-[30px]">
      <div>
        <h2 class="font-display text-[20px] font-semibold tracking-[-0.015em]">Publish your own agent.</h2>
        <p class="mt-2 max-w-[520px] text-[14px] leading-[1.6] text-g-muted">
          Scaffold it with the SDK, open a pull request against the hub manifest, and it lands
          here — versioned and immutable, installable by anyone in one command.
        </p>
      </div>
      <a
        href="https://amd-gaia.ai/docs/guides/hub-publishing"
        target="_blank"
        rel="noopener noreferrer"
        class="g-btn g-btn-secondary whitespace-nowrap"
      >Publishing guide →</a>
    </div>

  </main>
  <Footer />
</Layout>

<script is:inline>
  (() => {
    const published = Array.from(document.querySelectorAll('.agent-row'));
    const soon = Array.from(document.querySelectorAll('.soon-row'));
    const pills = Array.from(document.querySelectorAll('[data-filter]'));
    const search = document.getElementById('hub-search');
    const noPublished = document.getElementById('hub-no-published');
    const divider = document.getElementById('hub-soon-divider');
    const soonCount = document.getElementById('hub-soon-count');
    const empty = document.getElementById('hub-empty');
    const status = document.getElementById('hub-status');
    let category = 'all';

    // The rows sit inside two <ul>s, so the hairline sequence has to be spelled
    // out rather than read off hub-list's children.
    const hairlines = [...published, noPublished, divider, ...soon, empty];

    let announceTimer;
    const announce = (publishedVisible, soonVisible) => {
      clearTimeout(announceTimer);
      // Debounced: one message per pause in typing, not one per keystroke.
      announceTimer = setTimeout(() => {
        const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;
        status.textContent =
          publishedVisible + soonVisible === 0
            ? 'No agents match your search.'
            : `${plural(publishedVisible, 'published agent')}, ${plural(soonVisible, 'agent')} in development.`;
      }, 350);
    };

    const matches = (row, q) => {
      const catOk = category === 'all' || row.dataset.category === category;
      const qOk =
        !q ||
        row.dataset.name.includes(q) ||
        row.dataset.description.includes(q) ||
        row.dataset.tags.includes(q);
      return catOk && qOk;
    };

    function apply(notify) {
      const q = (search.value || '').trim().toLowerCase();
      let publishedVisible = 0;
      let soonVisible = 0;

      // `.hidden` (a utility) rather than the hidden attribute — the rows are
      // `display:grid`, which is also a utility and would otherwise win.
      published.forEach((row) => {
        const show = matches(row, q);
        row.classList.toggle('hidden', !show);
        if (show) publishedVisible++;
      });
      soon.forEach((row) => {
        const show = matches(row, q);
        row.classList.toggle('hidden', !show);
        if (show) soonVisible++;
      });

      noPublished.classList.toggle('hidden', publishedVisible > 0 || soonVisible === 0);
      divider.classList.toggle('hidden', soonVisible === 0);
      empty.classList.toggle('hidden', publishedVisible + soonVisible > 0);
      soonCount.textContent = soonVisible === 1 ? '1 agent' : `${soonVisible} agents`;

      // The container draws the outer border, so the last visible row must not
      // draw a second hairline on top of it.
      hairlines.forEach((el) => (el.style.borderBottomWidth = ''));
      const lastVisible = hairlines.filter((el) => !el.classList.contains('hidden')).pop();
      if (lastVisible) lastVisible.style.borderBottomWidth = '0';

      if (notify) announce(publishedVisible, soonVisible);
    }

    pills.forEach((pill) =>
      pill.addEventListener('click', () => {
        category = pill.dataset.filter;
        pills.forEach((p) => {
          p.classList.toggle('g-pill-active', p === pill);
          p.setAttribute('aria-pressed', String(p === pill));
        });
        apply(true);
      })
    );
    pills.forEach((p) => p.setAttribute('aria-pressed', String(p.classList.contains('g-pill-active'))));
    search.addEventListener('input', () => apply(true));
    apply(false);
  })();
</script>
