import '../design/tokens.css';
import '../design/global.css';
import StarField from '../components/StarField.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "GAIA is AMD's open-source agent factory: use the GAIA agent locally on your PC, or build your own agent harness with skills, evals and an auto-fix loop.",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The real GAIA mark, 180x180. Square, so cards use the `summary` layout
// rather than stretching it into a 1200x630 banner slot.
const shareImage = new URL('/gaia-icon.png', Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- The black canvas; a meta tag cannot read a CSS custom property. -->
    <meta name="theme-color" content="#000000" />
    <!-- Pre-paint: marks JS as available so scroll reveals may start hidden
         (without JS the class never lands and nothing is ever hidden), and
         restores a visitor's choice to pause the background (Footer.astro). -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('gaia-motion') === 'paused') document.documentElement.dataset.motion = 'paused';
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="The GAIA logo" />
    <meta property="og:site_name" content="GAIA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/gaia-icon.png" />

    <!-- Fonts. Antonio carries the identity, so a FOUT on h1 is very
         visible — fetch the stylesheet at highest priority, not lazily. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@500;600;700&family=Titillium+Web:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@500;600;700&family=Titillium+Web:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-g-bg font-sans text-g-text antialiased">
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-g-btn focus:bg-g-accent-fill focus:px-4 focus:py-2 focus:text-g-on-accent focus:outline-none">
      Skip to main content
    </a>

    <StarField />

    <!-- Content sits above the canvas (z-0). -->
    <div class="relative z-[1]">
      <slot />
    </div>

    <!-- Inline, not bundled: if this shared a module with the starfield, a
         starfield failure would leave every .g-reveal hidden. -->
    <script is:inline>
      // Scroll reveals (.g-reveal in global.css). One observer for the page;
      // each element is revealed once and then left alone.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.g-reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  /* Screen reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Headings carry the display face. Set here so every h1–h4 gets it without
     each page having to remember `font-display`. */
  h1, h2, h3, h4 {
    font-family: Antonio, 'Arial Narrow', Arial, sans-serif;
  }

  /* Link colors, defined globally — the previous site left these to browser
     defaults in some places. Nav and card links opt out with their own classes. */
  a {
    color: inherit;
    text-decoration: none;
  }
  .prose-link,
  .doc a {
    color: rgb(var(--g-accent-text));
  }
  .prose-link:hover,
  .doc a:hover {
    color: rgb(var(--g-accent2));
  }

  /* Custom scrollbar, drawn from the tokens */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: rgb(var(--g-bg));
  }
  ::-webkit-scrollbar-thumb {
    background: var(--g-border2);
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgb(var(--g-muted) / 0.5);
  }

  /* Firefox scrollbar */
  * {
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--g-muted) / 0.35) transparent;
  }

  pre {
    font-family: 'JetBrains Mono', monospace;
  }

  ::selection {
    background: rgb(var(--g-accent) / 0.3);
  }

  /* Visible focus ring everywhere. The prototypes style hover but not focus;
     pills, tabs, search and the copy button all need this. --g-focus is the
     accent, which clears SC 1.4.11's 3:1 on every surface. */
  :focus-visible {
    outline: 2px solid rgb(var(--g-focus));
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
