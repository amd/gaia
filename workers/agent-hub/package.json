    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
