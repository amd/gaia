{
  "name": "agent-hub-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker fronting the GAIA Agent Hub R2 bucket (publish API + catalog distribution).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
