{
  "name": "gaia-admin-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker serving the GAIA admin dashboard: nightly public-data snapshots (GitHub, npm, PyPI) in D1, behind Cloudflare Access.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply gaia-admin --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
